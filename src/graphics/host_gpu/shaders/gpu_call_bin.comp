#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// Call splitting (KYTY_SHADER_CALLS_SPLIT, shader/recompiler/CallSplit.h): the bin pass of one call
// site. One workgroup per guest wave. A wave suspended at the site (its header word is the site)
// is appended to the resume list (slot `targets`) and to the list of every callee slot a record
// of its active lanes names; each list's count is the X of its indirect dispatch.
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };
layout(push_constant) uniform Push {
	uint64_t state;   // wave blocks of `stride` dwords
	uint64_t header;  // one word per wave
	uint64_t map;     // record index -> callee slot
	uint64_t args;    // targets + 1 indirect dispatch commands {x, y, z}
	uint64_t lists;   // targets + 1 lists of `waves` words
	uint     stride;
	uint     waves;
	uint     site;
	uint     exec_lo; // uniform dwords of EXEC at the call loop
	uint     exec_hi;
	uint     record_dword; // lane 0 of the record-index register
	uint     records;
	uint     targets;
	uint64_t lanes;   // KYTY_SHADER_CALLS_SPLIT_STATS: targets + 2 lane counts (per slot, unrouted, all), or 0
} p;

shared uint seen[32];

void main() {
	const uint wave = gl_WorkGroupID.x;
	const uint lane = gl_LocalInvocationID.x;
	if (wave >= p.waves || Words(p.header).w[wave] != p.site) {
		return;
	}
	if (lane < 32u) {
		seen[lane] = 0u;
	}
	barrier();
	Words      state = Words(p.state + uint64_t(wave) * uint64_t(p.stride) * 4ul);
	const uint exec  = state.w[lane < 32u ? p.exec_lo : p.exec_hi];
	if (((exec >> (lane & 31u)) & 1u) != 0u) {
		const uint record = state.w[p.record_dword + lane];
		uint       routed = p.targets; // no callee slot: the lane resumes without the call
		if (record < p.records) {
			const uint slot = Words(p.map).w[record];
			if (slot < p.targets && slot < 1024u) {
				atomicOr(seen[slot >> 5u], 1u << (slot & 31u));
				routed = slot;
			}
		}
		if (p.lanes != 0ul) {
			atomicAdd(Words(p.lanes).w[routed], 1u);
			atomicAdd(Words(p.lanes).w[p.targets + 1u], 1u);
		}
	}
	barrier();
	Words args  = Words(p.args);
	Words lists = Words(p.lists);
	for (uint slot = lane; slot <= p.targets; slot += 64u) {
		const bool hit =
		    slot == p.targets || (slot < 1024u && (seen[slot >> 5u] & (1u << (slot & 31u))) != 0u);
		if (hit) {
			const uint n = atomicAdd(args.w[slot * 3u], 1u);
			args.w[slot * 3u + 1u] = 1u;
			args.w[slot * 3u + 2u] = 1u;
			lists.w[slot * p.waves + n] = wave;
		}
	}
}
