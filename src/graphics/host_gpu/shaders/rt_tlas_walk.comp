#version 460
#extension GL_GOOGLE_include_directive : require
// Native ray tracing (KYTY_RT_HW): walks the guest's top-level AMD BVH (sce::Psr 2.0 layout, Miles
// Morales: a header with the instance array offset at +40 and the node count at +80, box nodes
// from the header, instance leaves whose node index is the instance index; the header address is
// the 64-bit value at the base of the V# at the user data pointer + vsharp_offset, + header_offset)
// and writes one host acceleration structure instance per leaf. BLASes the host has no slot for
// yet are reported once each (see nativeRayTracing.cpp), and the built ones the TLAS references
// are listed for verification.

#include "rt_common.inc"

layout(local_size_x = 256) in;

layout(buffer_reference, std430, buffer_reference_align = 8) buffer TableEntry {
	uint64_t key;
	uint     slot;
	uint     flags;
};

layout(buffer_reference, std430, buffer_reference_align = 16) buffer InstanceRef {
	vec4     rows[3];
	uint     index_mask;
	uint     sbt_flags;
	uint64_t reference;
};

layout(buffer_reference, std430, buffer_reference_align = 8) buffer ContextEntry {
	uint64_t header_va;
	uint64_t tlas_address;
	uint64_t instance_nodes;
	uint64_t slots;
	uint     instance_count;
	uint     valid;
	uint64_t instance_base;
};

layout(push_constant, std430) uniform Push {
	uint64_t user_ptr_va;
	uint64_t state;
	uint64_t queue;
	uint64_t instance_nodes;
	uint64_t instances;
	uint64_t table;
	uint64_t slots;
	uint64_t missing;
	uint64_t context;
	uint64_t tlas_address;
	uint64_t verify_list;
	uint64_t header_hint;
	uint     vsharp_offset;
	uint     header_offset;
	uint     root;
	uint     queue_capacity;
	uint     instance_capacity;
	uint     table_mask;
	uint     missing_capacity;
	uint     prepare_id;
	uint     verify;
	uint     flip_parity;
} pc;

shared uint s_head;
shared uint s_tail;
shared uint s_next_tail;
shared uint s_valid;
shared uint64_t s_header;

const uint kSlotPending = 0xffffffffu;
// The key of a table entry the host released (an evicted slot, a BLAS to report again): lookups
// probe past it and new keys reuse it. Real keys are multiples of 8.
const uint64_t kTombstone = uint64_t(1);
const uint kNoEntry = 0xffffffffu;

TableEntry TableAt(uint index) {
	return TableEntry(pc.table + uint64_t(index) * 16);
}

// The slot of the BLAS an entry with its key holds; pending until the host writes slot + 1.
uint SlotOf(TableEntry entry) {
	const uint slot = entry.slot;
	return slot == 0 ? kSlotPending : slot - 1;
}

// Reports a BLAS whose entry was just claimed (the key was `previous` before); when the report
// list is full the entry is given back so the BLAS is reported again next time.
uint ReportMissing(TableEntry entry, uint index, uint64_t previous, uint64_t blas_va, uint root) {
	const uint missing = atomicAdd(RtState(pc.state).missing_count, 1u);
	if (missing < pc.missing_capacity) {
		MissingEntry report = MissingEntry(pc.missing + uint64_t(missing) * kMissingStride);
		report.blas_va      = blas_va;
		report.root         = root;
		report.table_index  = index;
		report.leaf_count   = 0;
		report.box_count    = 0;
		report.node_limit   = 0;
		report.flags        = 0;
	} else {
		atomicExchange(entry.key, previous);
	}
	return kSlotPending;
}

// Finds the slot of a BLAS. A BLAS the table does not have claims the first released entry of
// its probe chain (or the empty one ending the chain) and is reported in the missing list.
uint FindSlot(uint64_t blas_va, uint root) {
	const uint64_t key  = blas_va ^ (uint64_t(root) << 48);
	uint           hash = uint(key >> 6) * 0x9e3779b1u ^ uint(key >> 32) * 0x85ebca6bu;
	uint           released = kNoEntry;
	for (uint probe = 0; probe < 64; probe++) {
		const uint index = (hash + probe) & pc.table_mask;
		TableEntry entry = TableAt(index);
		uint64_t   found = entry.key;
		if (found == kTombstone) {
			if (released == kNoEntry) {
				released = index;
			}
			continue;
		}
		if (found == 0) {
			if (released != kNoEntry) {
				TableEntry reuse = TableAt(released);
				const uint64_t taken = atomicCompSwap(reuse.key, kTombstone, key);
				if (taken == kTombstone) {
					return ReportMissing(reuse, released, kTombstone, blas_va, root);
				}
				if (taken == key) {
					return SlotOf(reuse);
				}
				// Claimed for another BLAS meanwhile: the empty entry takes it.
			}
			found = atomicCompSwap(entry.key, uint64_t(0), key);
			if (found == 0) {
				return ReportMissing(entry, index, uint64_t(0), blas_va, root);
			}
		}
		if (found == key) {
			// The host writes slot + 1 once it has allocated the slot.
			return SlotOf(entry);
		}
	}
	if (released != kNoEntry) {
		// A full chain: reuse a released entry.
		TableEntry reuse = TableAt(released);
		const uint64_t taken = atomicCompSwap(reuse.key, kTombstone, key);
		if (taken == kTombstone) {
			return ReportMissing(reuse, released, kTombstone, blas_va, root);
		}
		if (taken == key) {
			return SlotOf(reuse);
		}
	}
	return kSlotPending;
}

void main() {
	const uint lid   = gl_LocalInvocationID.x;
	RtState    state = RtState(pc.state);
	if (lid == 0) {
		// The V# base (48 bits), then the header address in the buffer.
		const uvec4    vsharp = LoadGuestU32x4(pc.user_ptr_va + pc.vsharp_offset);
		const uint64_t base   = uint64_t(vsharp.x) | (uint64_t(vsharp.y & 0xffffu) << 32);
		const uint64_t header = pc.header_hint != 0 ? pc.header_hint
		                        : base != 0         ? LoadGuestU64(base + pc.header_offset)
		                                            : uint64_t(0);
		s_header              = header;
		s_valid               = header != 0 && (header & 255) == 0 && HostAddress(header) != 0 ? 1u : 0u;
		state.header_va       = header;
		if (s_valid != 0) {
			state.instance_base = header + LoadGuestU64(header + 40);
			state.node_limit    = LoadGuestU32(header + 80);
		}
		U32Ref(pc.queue).v = pc.root;
		s_head             = 0;
		s_tail             = 1;
	}
	barrier();
	if (s_valid == 0) {
		if (lid == 0 && pc.context != 0) {
			ContextEntry(pc.context).valid = 0;
		}
		return;
	}
	const uint64_t header        = s_header;
	const uint64_t instance_base = state.instance_base;
	uint           depth         = 0;
	// Level by level over the box nodes; the queue keeps every box node visited.
	while (true) {
		const uint head = s_head;
		const uint tail = s_tail;
		if (head == tail || depth > 64) {
			break;
		}
		if (lid == 0) {
			s_next_tail = tail;
		}
		barrier();
		for (uint i = head + lid; i < tail; i += gl_WorkGroupSize.x) {
			const uint node = U32Ref(pc.queue + uint64_t(i) * 4).v;
			const uint64_t address = NodeAddress(header, node);
			const uvec4 children = LoadGuestU32x4(address);
			for (uint c = 0; c < 4; c++) {
				const uint child = children[c];
				if (child == kInvalidNode) {
					continue;
				}
				const uint type = NodeType(child);
				if (type == 4u || type == 5u) {
					const uint slot = atomicAdd(s_next_tail, 1u);
					if (slot < pc.queue_capacity) {
						U32Ref(pc.queue + uint64_t(slot) * 4).v = child;
					} else {
						atomicOr(state.overflow, 1u);
					}
				} else if (type < 4u) {
					const uint index = atomicAdd(state.instance_count, 1u);
					if (index < pc.instance_capacity) {
						U32Ref(pc.instance_nodes + uint64_t(index) * 4).v = child;
					} else {
						atomicOr(state.overflow, 2u);
					}
				}
			}
		}
		barrier();
		if (lid == 0) {
			s_head = tail;
			s_tail = min(s_next_tail, pc.queue_capacity);
		}
		depth++;
		barrier();
	}
	if (lid == 0) {
		state.box_count = s_tail;
		state.max_depth = depth;
	}
	memoryBarrierBuffer();
	barrier();

	const uint count = min(state.instance_count, pc.instance_capacity);
	for (uint i = lid; i < count; i += gl_WorkGroupSize.x) {
		const uint     node   = U32Ref(pc.instance_nodes + uint64_t(i) * 4).v;
		const uint64_t record = instance_base + (uint64_t(node >> 3) << 7);
		// The 128-byte record: BLAS address at +0, a column-major 3x4 world-to-object matrix at +8,
		// the BLAS root at +56, the flags (low 4 bits) and the mask (bits 8-31) at +60.
		const uvec4    r0     = LoadGuestU32x4(record);
		const uvec4    r1     = LoadGuestU32x4(record + 16);
		const uvec4    r2     = LoadGuestU32x4(record + 32);
		const uvec4    extra  = LoadGuestU32x4(record + 48);
		const uint64_t blas   = uint64_t(r0.x) | (uint64_t(r0.y & 0xffffu) << 32);
		const uint     root   = extra.z;
		const uint     mask   = (extra.w >> 8) != 0 ? 0xffu : 0u;
		// Every triangle is a candidate the guest leaf code tests (facing, alpha, distance): no
		// host culling. Host instance flags: 1 = facing cull disable, 8 = force no opaque.
		const uint     host_flags = 1u | 8u;
		InstanceRef    out_instance = InstanceRef(pc.instances + uint64_t(i) * 64);
		uint64_t       reference    = 0;
		uint           slot         = kSlotPending;
		if (blas != 0 && mask != 0) {
			slot = FindSlot(blas, root);
			if (slot == kSlotPending) {
				atomicAdd(state.unknown_blas, 1u);
			} else {
				SlotInfo info = SlotInfo(pc.slots + uint64_t(slot) * kSlotStride);
				if (info.state == kSlotBuilt) {
					reference = info.as_address;
					// Each built slot is checked (and its use recorded) every pc.verify preparations.
					if (pc.verify != 0 && ((slot + pc.prepare_id) % pc.verify) == 0 &&
					    atomicExchange(info.stamp, pc.prepare_id) != pc.prepare_id) {
						const uint v = atomicAdd(state.verify_count, 1u);
						U32Ref(pc.verify_list + uint64_t(v) * 4).v = slot;
					}
				}
			}
		}
		// The guest matrix maps world to object space; the host instance needs its inverse.
		// Matrix floats m[c * 3 + r] at +8: m0..m1 = r0.zw, m2..m5 = r1, m6..m9 = r2, m10..m11 = extra.xy.
		const mat3 a  = mat3(uintBitsToFloat(uvec3(r0.z, r0.w, r1.x)),
		                     uintBitsToFloat(uvec3(r1.y, r1.z, r1.w)),
		                     uintBitsToFloat(uvec3(r2.x, r2.y, r2.z)));
		const vec3 t  = uintBitsToFloat(uvec3(r2.w, extra.x, extra.y));
		const float d = determinant(a);
		if (reference == 0 || !(abs(d) > 1e-30) || isnan(d) || isinf(d)) {
			atomicAdd(state.inactive, 1u);
			out_instance.rows[0]    = vec4(0);
			out_instance.rows[1]    = vec4(0);
			out_instance.rows[2]    = vec4(0);
			out_instance.index_mask = 0;
			out_instance.sbt_flags  = 0;
			out_instance.reference  = 0;
			continue;
		}
		const mat3 inv = inverse(a);
		const vec3 it  = -(inv * t);
		// A transform the hardware cannot use (non-finite or absurdly large values, as in a record
		// the guest is rewriting) leaves the instance inactive instead of undefined traversal.
		bool usable = true;
		for (uint c = 0; c < 3; c++) {
			const vec3 column = vec3(inv[c][0], inv[c][1], inv[c][2]);
			usable = usable && all(lessThan(abs(column), vec3(1e18))) && !any(isnan(column));
		}
		usable = usable && all(lessThan(abs(it), vec3(1e18))) && !any(isnan(it));
		if (!usable) {
			atomicAdd(state.inactive, 1u);
			out_instance.rows[0]    = vec4(0);
			out_instance.rows[1]    = vec4(0);
			out_instance.rows[2]    = vec4(0);
			out_instance.index_mask = 0;
			out_instance.sbt_flags  = 0;
			out_instance.reference  = 0;
			continue;
		}
		// Row-major 3x4 (VkTransformMatrixKHR).
		out_instance.rows[0]    = vec4(inv[0][0], inv[1][0], inv[2][0], it.x);
		out_instance.rows[1]    = vec4(inv[0][1], inv[1][1], inv[2][1], it.y);
		out_instance.rows[2]    = vec4(inv[0][2], inv[1][2], inv[2][2], it.z);
		out_instance.index_mask = (slot & 0xffffffu) | (mask << 24);
		out_instance.sbt_flags  = host_flags << 24;
		out_instance.reference  = reference;
	}
	memoryBarrierBuffer();
	barrier();
	if (lid == 0) {
		const uint missing = min(state.missing_count, pc.missing_capacity);
		state.dispatch_x   = missing;
		state.dispatch_y   = 1;
		state.dispatch_z   = 1;
		state.verify_x     = state.verify_count;
		state.verify_y     = 1;
		state.verify_z     = 1;
		if (pc.context != 0) {
			ContextEntry context   = ContextEntry(pc.context);
			context.header_va      = s_header;
			context.tlas_address   = pc.tlas_address;
			context.instance_nodes = pc.instance_nodes;
			context.slots          = pc.slots;
			context.instance_count = count;
			context.instance_base  = instance_base;
			context.valid          = pc.tlas_address != 0 ? 1u : 0u;
		}
	}
}
