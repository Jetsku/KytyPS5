+static float GetSteamHapticGain(void)
+{
+    // Percentage, 100 = default strength
+    const char *hint = SDL_GetHint("SDL_JOYSTICK_HIDAPI_STEAM_RUMBLE_GAIN");
+    int gain = hint ? SDL_atoi(hint) : 100;
+    return SDL_clamp(gain, 0, 1000) / 100.0f;
+}
+
+static bool SendSteamHapticPulse(SDL_HIDAPI_Device *device, int side, Uint16 amplitude, Uint16 frequency, float gain)
+{
+    unsigned char buf[65];
+    FeatureReportMsg *msg = (FeatureReportMsg *)(buf + 1);
+    Uint32 period_us = 1000000 / SDL_clamp(frequency, STEAM_HAPTIC_MIN_FREQ, STEAM_HAPTIC_MAX_FREQ);
+    Uint32 on_us = 0;
+    Uint16 count = 0;
+
+    if (amplitude > 0 && gain > 0.0f) {
+        float duty = SDL_min(amplitude / 65535.0f * STEAM_HAPTIC_FULL_DUTY * gain, STEAM_HAPTIC_MAX_DUTY);
+        on_us = SDL_max((Uint32)(period_us * duty), 10);
+        count = (Uint16)((STEAM_HAPTIC_WINDOW_US + period_us - 1) / period_us);
+    }
+
+    SDL_zero(buf);
+    msg->header.type = ID_TRIGGER_HAPTIC_PULSE;
+    msg->header.length = 7; // which_pad, pulse_duration, pulse_interval, pulse_count
+    msg->payload.fireHapticPulse.which_pad = (side == STEAM_HAPTIC_LEFT) ? 1 : 0;
+    msg->payload.fireHapticPulse.pulse_duration = (unsigned short)on_us;
+    msg->payload.fireHapticPulse.pulse_interval = (unsigned short)(count ? period_us - on_us : 0);
+    msg->payload.fireHapticPulse.pulse_count = count;
+
+    return SetFeatureReport(device, buf, 2 + 1 + msg->header.length) >= 0;
+}
+
+static bool SteamHapticChanged(Uint16 amplitude, Uint16 frequency, Uint16 sent_amplitude, Uint16 sent_frequency)
+{
+    // A new train restarts the pulse phase, so small changes wait for the next refresh
+    if ((amplitude == 0) != (sent_amplitude == 0)) {
+        return true;
+    }
+    if (amplitude == 0) {
+        return false;
+    }
+    return SDL_abs((int)amplitude - (int)sent_amplitude) * 8 > (int)sent_amplitude ||
+           SDL_abs((int)frequency - (int)sent_frequency) * 8 > (int)sent_frequency;
+}
+
+static int SDLCALL SteamHapticThread(void *data)
+{
+    SDL_HIDAPI_Device *device = (SDL_HIDAPI_Device *)data;
+    SDL_DriverSteam_Context *ctx = (SDL_DriverSteam_Context *)device->context;
+    SteamHapticState *haptics = &ctx->haptics;
+    Uint16 sent_amplitude[2] = { 0, 0 };
+    Uint16 sent_frequency[2] = { 0, 0 };
+    Uint64 sent_time[2] = { 0, 0 };
+    Uint64 stats_time = SDL_GetTicks();
+    int stats_reports = 0, stats_failures = 0;
+    Uint16 stats_peak = 0;
+
+    SDL_SetCurrentThreadPriority(SDL_THREAD_PRIORITY_HIGH);
+
+    SDL_LockMutex(haptics->lock);
+    while (!haptics->quit) {
+        Uint64 now = SDL_GetTicks();
+        Uint16 amplitude[2], frequency[2];
+        bool send[2];
+        Sint32 wait_ms = -1;
+        float gain;
+        int side;
+
+        if (haptics->until && now >= haptics->until) {
+            haptics->amplitude[0] = haptics->amplitude[1] = 0;
+            haptics->until = 0;
+        }
+        for (side = 0; side < 2; ++side) {
+            amplitude[side] = haptics->amplitude[side];
+            frequency[side] = haptics->frequency[side];
+            send[side] = SteamHapticChanged(amplitude[side], frequency[side], sent_amplitude[side], sent_frequency[side]) ||
+                         (amplitude[side] && now >= sent_time[side] + STEAM_HAPTIC_REFRESH_MS);
+            if (!send[side] && amplitude[side]) {
+                Sint32 due = (Sint32)(sent_time[side] + STEAM_HAPTIC_REFRESH_MS - now);
+                wait_ms = (wait_ms < 0) ? due : SDL_min(wait_ms, due);
+            }
+        }
+        if (!send[0] && !send[1]) {
+            if (haptics->until) {
+                Sint32 due = (Sint32)(haptics->until - now);
+                wait_ms = (wait_ms < 0) ? due : SDL_min(wait_ms, due);
+            }
+            if (!haptics->dirty) {
+                SDL_WaitConditionTimeout(haptics->cond, haptics->lock, SDL_max(wait_ms, -1));
+            }
+            haptics->dirty = false;
+            continue;
+        }
+        haptics->dirty = false;
+        SDL_UnlockMutex(haptics->lock);
+
+        gain = GetSteamHapticGain();
+        for (side = 0; side < 2; ++side) {
+            if (!send[side]) {
+                continue;
+            }
+            if (SendSteamHapticPulse(device, side, amplitude[side], frequency[side], gain)) {
+                ++stats_reports;
+            } else {
+                ++stats_failures;
+            }
+            sent_amplitude[side] = amplitude[side];
+            sent_frequency[side] = frequency[side];
+            sent_time[side] = SDL_GetTicks();
+            stats_peak = SDL_max(stats_peak, amplitude[side]);
+        }
+        if (now >= stats_time + 1000) {
+            if (stats_reports || stats_failures) {
+                SteamRumbleLog("haptics: %d reports/s, %d failed, peak amplitude %u, last L %u@%uHz R %u@%uHz",
+                               stats_reports, stats_failures, stats_peak,
+                               amplitude[0], frequency[0], amplitude[1], frequency[1]);
+            }
+            stats_time = now;
+            stats_reports = stats_failures = 0;
+            stats_peak = 0;
+        }
+
+        SDL_LockMutex(haptics->lock);
+    }
+    SDL_UnlockMutex(haptics->lock);
+
+    // Leave the actuators quiet
+    for (int side = 0; side < 2; ++side) {
+        if (sent_amplitude[side]) {
+            SendSteamHapticPulse(device, side, 0, 0, 0.0f);
+        }
+    }
+    return 0;
+}
+
+static void StartSteamHaptics(SDL_HIDAPI_Device *device, SDL_DriverSteam_Context *ctx)
+{
+    SteamHapticState *haptics = &ctx->haptics;
+
+    SDL_zerop(haptics);
+    haptics->lock = SDL_CreateMutex();
+    haptics->cond = SDL_CreateCondition();
+    if (haptics->lock && haptics->cond) {
+        haptics->thread = SDL_CreateThread(SteamHapticThread, "SDL Steam Controller haptics", device);
+    }
+    SteamRumbleLog("Steam Controller opened by patched SDL %d.%d.%d (bluetooth=%d, haptics thread %s)",
+                   SDL_MAJOR_VERSION, SDL_MINOR_VERSION, SDL_MICRO_VERSION, device->is_bluetooth,
+                   haptics->thread ? "running" : "FAILED");
+}
+
+static void StopSteamHaptics(SDL_DriverSteam_Context *ctx)
+{
+    SteamHapticState *haptics = &ctx->haptics;
+
+    if (haptics->thread) {
+        SDL_LockMutex(haptics->lock);
+        haptics->quit = true;
+        SDL_SignalCondition(haptics->cond);
+        SDL_UnlockMutex(haptics->lock);
+        SDL_WaitThread(haptics->thread, NULL);
+    }
+    if (haptics->cond) {
+        SDL_DestroyCondition(haptics->cond);
+    }
+    if (haptics->lock) {
+        SDL_DestroyMutex(haptics->lock);
+    }
+    SDL_zerop(haptics);
+}
+
+static bool SetSteamHaptics(SDL_DriverSteam_Context *ctx, Uint16 left, Uint16 left_freq, Uint16 right, Uint16 right_freq, Uint32 duration_ms)
+{
+    SteamHapticState *haptics = &ctx->haptics;
+
+    if (!haptics->thread) {
+        return SDL_SetError("Steam Controller haptics thread isn't running");
+    }
+    SDL_LockMutex(haptics->lock);
+    haptics->amplitude[STEAM_HAPTIC_LEFT] = left;
+    haptics->frequency[STEAM_HAPTIC_LEFT] = left_freq;
+    haptics->amplitude[STEAM_HAPTIC_RIGHT] = right;
+    haptics->frequency[STEAM_HAPTIC_RIGHT] = right_freq;
+    haptics->until = duration_ms ? SDL_GetTicks() + duration_ms : 0;
+    haptics->dirty = true;
+    SDL_SignalCondition(haptics->cond);
+    SDL_UnlockMutex(haptics->lock);
+    return true;
+}
