+// Diagnostics: SDL_JOYSTICK_HIDAPI_STEAM_RUMBLE_LOG=<file> appends haptics activity to that file
+static void SteamRumbleLog(const char *fmt, ...)
+{
+    const char *path = SDL_getenv("SDL_JOYSTICK_HIDAPI_STEAM_RUMBLE_LOG");
+    SDL_IOStream *io;
+    char line[256];
+    va_list ap;
+    int len;
+
+    if (!path || !*path) {
+        return;
+    }
+    len = SDL_snprintf(line, sizeof(line), "[%llu ms] ", (unsigned long long)SDL_GetTicks());
+    va_start(ap, fmt);
+    len += SDL_vsnprintf(line + len, sizeof(line) - len - 2, fmt, ap);
+    va_end(ap);
+    len = SDL_min(len, (int)sizeof(line) - 2);
+    line[len++] = 10;
+    io = SDL_IOFromFile(path, "ab");
+    if (io) {
+        SDL_WriteIO(io, line, len);
+        SDL_CloseIO(io);
+    }
+}
