+/* Haptics for the two trackpad actuators.
+ *
+ * Plain rumble maps the low frequency motor to the left pad and the high frequency motor to the right one.
+ * SDL_SendGamepadEffect() also takes a SteamHapticEffect, an amplitude and frequency per pad, so that
+ * audio-driven haptics (such as converted DualSense haptics) keep their character.
+ *
+ * Each pad plays a train of pulses at the requested frequency; the duty cycle sets the strength.
+ * Sending a feature report takes about 3 ms over the wireless dongle, so a thread sends the latest
+ * values and callers never wait for the controller.
+ */
+#define STEAM_HAPTIC_EFFECT_MAGIC 0x50484353 // 'SCHP'
+
+typedef struct
+{
+    Uint32 magic;
+    Uint16 amplitude[2]; // left pad, right pad: 0-65535
+    Uint16 frequency[2]; // Hz
+    Uint16 duration_ms;
+} SteamHapticEffect;
+
+#define STEAM_HAPTIC_LEFT          0
+#define STEAM_HAPTIC_RIGHT         1
+#define STEAM_HAPTIC_WINDOW_US     60000 // length of each pulse train
+#define STEAM_HAPTIC_REFRESH_MS    40    // renewal of a steady value, before its train ends
+#define STEAM_HAPTIC_MIN_FREQ      30
+#define STEAM_HAPTIC_MAX_FREQ      1000
+#define STEAM_HAPTIC_FULL_DUTY     0.05f // duty cycle at full amplitude and 100% gain
+#define STEAM_HAPTIC_MAX_DUTY      0.5f
+#define STEAM_RUMBLE_LOW_FREQ      125
+#define STEAM_RUMBLE_HIGH_FREQ     250
+
+typedef struct
+{
+    SDL_Mutex *lock;
+    SDL_Condition *cond;
+    SDL_Thread *thread;
+    bool quit;
+    bool dirty;
+    Uint16 amplitude[2];
+    Uint16 frequency[2];
+    Uint64 until; // ticks when the effect ends, 0 = until changed
+} SteamHapticState;
+
 typedef struct
 {
     SDL_HIDAPI_Device *device;
