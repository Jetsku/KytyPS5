+void ExhaustiveV3Immediate() {
+    Check(Xbyak::util::Cpu().has(Xbyak::util::Cpu::tAVX), "exhaustive YMM test requires AVX");
+    Fixture f;
+    std::mt19937_64 random(0x334455abcd);
+    const auto saved_mxcsr = _mm_getcsr();
+    uint64_t cases = 0;
+    for (int dst = 0; dst < 16; ++dst) for (unsigned length = 0; length < 64; ++length)
+    for (unsigned index = 0; index < 64; ++index) for (unsigned wrap = 0; wrap < 4; ++wrap)
+    for (unsigned pattern = 0; pattern < 3; ++pattern) {
+        State input {}, expected {}, output {};
+        for (auto& reg : input.ymm) for (auto& qword : reg)
+            qword = pattern == 0 ? 0 : pattern == 1 ? UINT64_MAX : random();
