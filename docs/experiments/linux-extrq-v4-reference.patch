+static void Handler(int, siginfo_t*, void* context) {
+    traps = traps + 1;
+    if (!Loader::X64InstructionEmulator::TryEmulate(context)) _exit(190);
+}
+void RunLinuxNativeMicrobenchmark();
+void RunRegisterMicrobenchmark();
+int main(int argc, char** argv) {
+    if (argc == 2 && std::strcmp(argv[1], "--register-microbenchmark") == 0) {
+        RunRegisterMicrobenchmark(); return 0;
+    }
+    if (argc == 2 && std::strcmp(argv[1], "--microbenchmark") == 0) {
+        RunLinuxNativeMicrobenchmark(); return 0;
+    }
+    struct sigaction action {};
+    action.sa_sigaction = Handler; action.sa_flags = SA_SIGINFO;
+    sigaction(SIGILL, &action, nullptr);
+    constexpr size_t size = 0x4000;
+    void* memory = mmap(nullptr, size * 2, PROT_READ | PROT_WRITE,
+                        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (memory == MAP_FAILED) return 2;
+    auto address = reinterpret_cast<uintptr_t>(memory);
+    Xbyak::CodeGenerator c(size, memory);
+    const bool v2 = argc > 2;
+    const auto dst = argc > 1 && !v2 ? c.xmm9 : c.xmm0;
+    c.movdqu(dst, c.ptr[c.rdi]);
+    if (argc > 1) {
+        c.mov(c.rax, 0x0408); c.movq(v2 ? c.xmm1 : c.xmm10, c.rax);
+        const uint8_t reg_extrq[] = {0x66, 0x45, 0x0f, 0x79, 0xca};
+        const uint8_t short_extrq[] = {0x66, 0x0f, 0x79, 0xc1};
+        if (v2) c.db(short_extrq, sizeof(short_extrq));
+        else c.db(reg_extrq, sizeof(reg_extrq));
+    } else {
+        const uint8_t extrq[] = {0x66, 0x0f, 0x78, 0xc0, 8, 4};
+        c.db(extrq, sizeof(extrq));
+    }
+    c.movdqu(c.ptr[c.rsi], dst); c.ret();
+    std::array<uint64_t, 2> input {0x123456789abcdef0ull, UINT64_MAX}, output {};
+    setenv("KYTY_LINUX_NATIVE_CPU", v2 ? "extrq-v2" : "extrq", 1);
+    Loader::LinuxNative::RegisterRedZonePatchModule(memory, size, reinterpret_cast<void*>(address + size), size);
+    const std::array<uintptr_t, 1> starts {address};
+    Loader::LinuxNative::PatchGuestInstructions(address, c.getSize(), starts, false, false);
+    if (mprotect(memory, size * 2, PROT_READ | PROT_EXEC) != 0) return 6;
+    reinterpret_cast<void (*)(const uint64_t*, uint64_t*)>(memory)(input.data(), output.data());
+    std::printf("EXTRQ result=%llx upper=%llx SIGILL=%d\n",
+                (unsigned long long)output[0], (unsigned long long)output[1], (int)traps);
+    Loader::LinuxNative::UnregisterRedZonePatchModule(memory);
+    munmap(memory, size * 2);
+    if (output[0] != 0xef || output[1] != 0) return 3;
+    if (traps != 0) { std::puts("FAIL: EXTRQ still enters SIGILL (native replacement missing)"); return 1; }
+    std::puts("PASS: EXTRQ executes without SIGILL");
+    if (argc == 1) { RunLinuxNativeV2PlanningTests("extrq-v2"); RunLinuxNativeV2PlanningTests("extrq-v3"); RunLinuxNativeV2PlanningTests("extrq-v4"); RunLinuxNativeEquivalenceTests(); }
+}
diff --git a/tests/linuxNativeInt15IntegrationTests.cpp b/tests/linuxNativeInt15IntegrationTests.cpp
new file mode 100644
index 0000000..16879ad
--- /dev/null
+++ b/tests/linuxNativeInt15IntegrationTests.cpp
@@ -0,0 +1,42 @@
+// Preserve int15's later --amd-cpu pass: never steal its replacement sites.
+#include "loader/redZonePatcher.h"
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <sys/mman.h>
+int main() {
+    constexpr size_t size = 4096;
+    auto* memory = static_cast<unsigned char*>(mmap(nullptr, size * 2,
+        PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+    if (memory == MAP_FAILED) return 2;
+    const auto base = reinterpret_cast<uintptr_t>(memory);
+    const std::array<uintptr_t, 1> roots {base};
+    unsigned cases = 0;
+    // EXTRQ xmm0,xmm1 followed by an int15 AMD-compatibility instruction.
+    const unsigned char codes[][12] = {
+        {0x66,0x0f,0x79,0xc1, 0x0f,0x52,0xc2, 0xc3}, // RSQRTPS
+        {0x66,0x0f,0x79,0xc1, 0xf3,0x0f,0x52,0xc2, 0xc3}, // RSQRTSS
+        {0x66,0x0f,0x79,0xc1, 0xc5,0xf8,0x52,0xc2, 0xc3}, // VRSQRTPS
+        {0x66,0x0f,0x79,0xc1, 0xf2,0x0f,0x79,0xc2, 0xc3}, // INSERTQ
+        {0x66,0x0f,0x79,0xc1, 0xf3,0x0f,0xc7,0xf8, 0xc3}, // RDPID
+        {0x66,0x0f,0x79,0xc1, 0x66,0x0f,0xae,0x30, 0xc3}, // CLWB
+    };
+    for (const auto* mode : {"extrq-v2", "extrq-v3", "extrq-v4"}) {
+        setenv("KYTY_LINUX_NATIVE_CPU", mode, 1);
+        for (const auto& code : codes) {
+            std::memcpy(memory, code, sizeof(code));
+            Loader::LinuxNative::RegisterRedZonePatchModule(memory, size, memory + size, size);
+            const auto result = Loader::LinuxNative::PatchGuestInstructions(base, sizeof(code), roots, false, true);
+            if (result.extrq_found_count != 1 || result.extrq_native_count != 0 ||
+                std::memcmp(memory, code, sizeof(code)) != 0) {
+                std::fprintf(stderr, "FAIL: %s stole an int15 AMD replacement neighbor (case %u)\n", mode, cases);
+                return 1;
+            }
+            Loader::LinuxNative::UnregisterRedZonePatchModule(memory);
+            ++cases;
+        }
+    }
+    munmap(memory, size * 2);
+    std::printf("PASS: int15 AMD replacement neighbors remain in original code; cases=%u\n", cases);
+}
diff --git a/tests/linuxNativeV2PlanningTests.cpp b/tests/linuxNativeV2PlanningTests.cpp
new file mode 100644
index 0000000..21d0b0e
--- /dev/null
+++ b/tests/linuxNativeV2PlanningTests.cpp
@@ -0,0 +1,197 @@
+// Bounded CFG/neighbor regressions for the explicitly experimental v2 mode.
+#include "loader/redZonePatcher.h"
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include <sys/mman.h>
+void RunLinuxNativeV2PlanningTests(const char* mode);
+int LinuxNativeTestTrapCount();
+namespace {
+void Check(bool ok, const char* message) { if (!ok) { std::fprintf(stderr,"FAIL: %s\n",message); std::exit(5); } }
+void RipRangeFallback(const char* mode) {
+    constexpr size_t page=4096;
+    void* guest=MAP_FAILED; void* trampoline=MAP_FAILED;
+    uintptr_t base=0;
+    for (uintptr_t candidate : {0x20000000000ull,0x30000000000ull,0x40000000000ull}) {
+        guest=mmap(reinterpret_cast<void*>(candidate),page,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0);
+        if(guest==MAP_FAILED) continue;
+        trampoline=mmap(reinterpret_cast<void*>(candidate+0x7fff0000),page,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0);
+        if(trampoline!=MAP_FAILED) { base=candidate; break; }
+        munmap(guest,page); guest=MAP_FAILED;
+    }
+    Check(guest!=MAP_FAILED && trampoline!=MAP_FAILED,"range fixture mappings");
+    std::array<uint8_t,12> code{0x66,0x0f,0x79,0xc1,0x4c,0x8b,0x1d,0,0,0,0,0xc3};
+    // Original load can reach its target; relocated load cannot. Target is never executed/read.
+    const int32_t displacement=-0x20000-11;
+    std::memcpy(code.data()+7,&displacement,4); std::memcpy(guest,code.data(),code.size());
+    Loader::LinuxNative::RegisterRedZonePatchModule(guest,page,trampoline,page);
+    const std::array<uintptr_t,1> roots{base};
+    setenv("KYTY_LINUX_NATIVE_CPU",mode,1);
+    auto r=Loader::LinuxNative::PatchGuestInstructions(base,code.size(),roots,false,false);
+    Check(r.extrq_found_count==1 && r.extrq_native_count==0 && r.extrq_fallback_count==1,"RIP encoder range fallback");
+    Check(std::memcmp(guest,code.data(),code.size())==0,"RIP range fallback changed guest");
+    const uint8_t normal[]={0x66,0x0f,0x79,0xc1,0x90,0xc3}; std::memcpy(guest,normal,sizeof(normal));
+    auto retry=Loader::LinuxNative::PatchGuestInstructions(base,sizeof(normal),roots,false,false);
+    Check(retry.extrq_native_count==1,"failed encoding consumed capacity/patch marker");
+    const int32_t expected=static_cast<int32_t>(reinterpret_cast<uintptr_t>(trampoline) + (std::strcmp(mode,"extrq-v4")==0 ? 32 : 0) -(base+5));
+    int32_t actual=0; std::memcpy(&actual,static_cast<uint8_t*>(guest)+1,4);
+    Check(actual==expected,"failed encoding did not rewind trampoline");
+    Loader::LinuxNative::UnregisterRedZonePatchModule(guest); munmap(guest,page); munmap(trampoline,page);
+    std::puts("PASS: RIP-neighbor encoder out-of-range fallback, unchanged guest, emission rewind/retry");
+}
+}
+void V4JumpBoundary() {
+    constexpr size_t page = 4096;
+    const uintptr_t base = 0x50000000000ull;
+    void* guest = mmap(reinterpret_cast<void*>(base), page, PROT_READ | PROT_WRITE,
+        MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    void* trampoline = mmap(reinterpret_cast<void*>(base - (uint64_t{1} << 31)), page, PROT_READ | PROT_WRITE,
+        MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    Check(guest != MAP_FAILED && trampoline != MAP_FAILED, "v4 jump boundary maps");
+    const uint8_t code[] {0x66, 0x0f, 0x79, 0xc1, 0x90, 0xc3};
+    std::memcpy(static_cast<uint8_t*>(guest) + 40, code, sizeof(code));
+    Loader::LinuxNative::RegisterRedZonePatchModule(guest, page, trampoline, page);
+    setenv("KYTY_LINUX_NATIVE_CPU", "extrq-v4", 1);
+    const std::array<uintptr_t, 1> roots {base + 40};
+    const auto r = Loader::LinuxNative::PatchGuestInstructions(base, 46, roots, false, false);
+    Check(r.extrq_found_count == 1 && r.extrq_native_count == 0 && r.extrq_fallback_count == 1,
+          "v4 exact guest jump displacement boundary must fall back");
+    Check(std::memcmp(static_cast<uint8_t*>(guest) + 40, code, sizeof(code)) == 0, "v4 boundary changed guest");
+    // Same module, retry at an in-range site: exact rollback includes constants.
+    std::memcpy(guest, code, sizeof(code));
+    const std::array<uintptr_t, 1> retry_roots {base};
+    Check(Loader::LinuxNative::PatchGuestInstructions(base, sizeof(code), retry_roots, false, false).extrq_native_count == 1, "v4 boundary rewind retry");
+    int32_t actual; std::memcpy(&actual, static_cast<uint8_t*>(guest) + 1, 4);
+    Check(actual == INT32_MIN + 27, "v4 boundary rewind consumed constants/code");
+    Loader::LinuxNative::UnregisterRedZonePatchModule(guest); munmap(guest, page); munmap(trampoline, page);
+    std::puts("PASS: v4 exact rel32 lower-bound rejection and full constant/body rewind retry");
+}
+void V4ConstantsCapacity() {
+    constexpr size_t size = 4096;
+    void* memory = mmap(nullptr, size * 2, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    Check(memory != MAP_FAILED, "v4 constants map");
+    const auto base = reinterpret_cast<uintptr_t>(memory);
+    const uint8_t code[] {0x66,0x0f,0x79,0xc1,0x90,0x66,0x0f,0x79,0xd3,0x90,0xc3};
+    const std::array<uintptr_t, 1> roots {base};
+    for (size_t capacity : {303u, 304u, 4093u}) {
+        std::memcpy(memory, code, sizeof(code));
+        Loader::LinuxNative::UnregisterRedZonePatchModule(memory);
+        // Deliberately unaligned start: Xbyak must align actual constant addresses.
+        Loader::LinuxNative::RegisterRedZonePatchModule(memory, size, reinterpret_cast<void*>(base + size + 3), capacity);
+        setenv("KYTY_LINUX_NATIVE_CPU", "extrq-v4", 1);
+        const auto r = Loader::LinuxNative::PatchGuestInstructions(base, sizeof(code), roots, false, false);
+        if (capacity == 303) {
+            Check(r.extrq_native_count == 0 && std::memcmp(memory, code, sizeof(code)) == 0, "v4 constant reserve capacity fallback");
+        } else {
+            Check(r.extrq_native_count == (capacity == 304 ? 1u : 2u), "v4 constant reserve/native counts");
+            int32_t displacement; std::memcpy(&displacement, static_cast<uint8_t*>(memory) + 1, 4);
+            Check(base + 5 + displacement == base + size + 48, "v4 constant alignment layout");
+            const auto* constants = reinterpret_cast<const uint64_t*>(base + size + 16);
+            Check(constants[0] == 63 && constants[1] == 0 && constants[2] == 1 && constants[3] == 0, "v4 aligned constants");
+            if (capacity > 304) {
+                std::memcpy(&displacement, static_cast<uint8_t*>(memory) + 6, 4);
+                const auto second = base + 10 + displacement;
+                // MOVDQU(2), MOVDQA(2), shifts(4), LEA precede PXOR. Verify shared
+                // constants by finding the legacy PXOR's RIP-relative disp32.
+                bool found = false;
+                for (size_t i = 0; i < 100; ++i) {
+                    const auto* b = reinterpret_cast<const uint8_t*>(second + i);
+                    if (b[0] == 0x66 && b[1] == 0x0f && b[2] == 0xef && (b[3] & 0xc7) == 0x05) {
+                        int32_t d; std::memcpy(&d, b + 4, 4);
+                        Check(second + i + 8 + d == base + size + 16, "v4 per-site duplicated constants");
+                        found = true; break;
+                    }
+                }
+                Check(found, "v4 shared constant read missing");
+            }
+        }
+    }
+    Loader::LinuxNative::UnregisterRedZonePatchModule(memory); munmap(memory, size * 2);
+    std::puts("PASS: v4 unaligned trampoline, aligned constants, exact reserve threshold, shared per-pass constants");
+}
+void RunLinuxNativeV2PlanningTests(const char* mode) {
+    if (std::strcmp(mode, "extrq-v4") == 0) { V4JumpBoundary(); V4ConstantsCapacity(); }
+    RipRangeFallback(mode);
+    constexpr size_t size=0x4000;
+    void* memory=mmap(nullptr,size*2,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+    Check(memory!=MAP_FAILED,"planning mmap");
+    auto address=reinterpret_cast<uintptr_t>(memory);
+    struct Case { const char* name; std::vector<uint8_t> code; std::vector<size_t> roots; size_t found,native; };
+    std::vector<Case> cases {
+        {"x87 instruction PC tracking unsupported",{0x66,0x0f,0x79,0xc1,0xd9,0xe8,0xc3},{0},1,0},
+        {"syscall clobbers RCX with instruction PC",{0x66,0x0f,0x79,0xc1,0x0f,0x05,0xc3},{0},1,0},
+        {"short plus nop",{0x66,0x0f,0x79,0xc1,0x90,0xc3},{0},1,1},
+        {"short end",{0x66,0x0f,0x79,0xc1},{0},1,0},
+        {"return neighbor",{0x66,0x0f,0x79,0xc1,0xc3},{0},1,0},
+        {"relative branch neighbor",{0x66,0x0f,0x79,0xc1,0xeb,0,0xc3},{0},1,0},
+        {"conditional neighbor",{0x66,0x0f,0x79,0xc1,0x74,0,0xc3},{0},1,0},
+        {"relative call neighbor",{0x66,0x0f,0x79,0xc1,0xe8,0,0,0,0,0xc3},{0},1,0},
+        {"direct incoming neighbor",{0x74,4,0x66,0x0f,0x79,0xc1,0x90,0xc3},{0},1,0},
+        {"root at neighbor",{0x66,0x0f,0x79,0xc1,0x90,0xc3},{0,4},1,0},
+        {"two neighboring EXTRQ",{0x66,0x0f,0x79,0xc1,0x66,0x0f,0x79,0xc2,0x90,0xc3},{0},2,1},
+        {"earlier overlapping decode",{0x74,2,0xb8,0,0x66,0x0f,0x79,0xc1,0x90,0xc3,0x90,0x90,0x90,0xc3},{0},1,0},
+        {"invalid neighbor decode",{0x66,0x0f,0x79,0xc1,0x0f,4},{0},1,0}
+    };
+    size_t total=0;
+    for (const auto& t: cases) {
+        Loader::LinuxNative::UnregisterRedZonePatchModule(memory);
+        std::memcpy(memory,t.code.data(),t.code.size());
+        Loader::LinuxNative::RegisterRedZonePatchModule(memory,size,reinterpret_cast<void*>(address+size),size);
+        std::vector<uintptr_t> roots; for(auto r:t.roots) roots.push_back(address+r);
+        setenv("KYTY_LINUX_NATIVE_CPU",mode,1);
+        auto result=Loader::LinuxNative::PatchGuestInstructions(address,t.code.size(),roots,false,false);
+        if(result.extrq_found_count!=t.found || result.extrq_native_count!=t.native) {
+            std::fprintf(stderr,"case=%s found=%zu native=%zu expected=%zu/%zu\n",t.name,
+                size_t(result.extrq_found_count),size_t(result.extrq_native_count),t.found,t.native);
+            Check(false,"neighbor planning");
+        }
+        Check(result.extrq_fallback_count==t.found-t.native,"planning fallback count");
+        if(t.native==0) Check(std::memcmp(memory,t.code.data(),t.code.size())==0,"fallback changed guest bytes");
+        ++total;
+    }
+    // v1 must leave exactly the same eligible short fixture trapped.
+    Loader::LinuxNative::UnregisterRedZonePatchModule(memory);
+    const uint8_t short_code[]={0x66,0x0f,0x79,0xc1,0x90,0xc3};
+    std::memcpy(memory,short_code,sizeof(short_code));
+    Loader::LinuxNative::RegisterRedZonePatchModule(memory,size,reinterpret_cast<void*>(address+size),size);
+    const std::array<uintptr_t,1> roots{address};
+    setenv("KYTY_LINUX_NATIVE_CPU","extrq",1);
+    auto v1=Loader::LinuxNative::PatchGuestInstructions(address,sizeof(short_code),roots,false,false);
+    Check(v1.extrq_found_count==1 && v1.extrq_native_count==0 && v1.extrq_fallback_count==1,"v1 short unchanged");
+    Check(std::memcmp(memory,short_code,sizeof(short_code))==0,"v1 changed short bytes");
+    setenv("KYTY_LINUX_NATIVE_CPU",mode,1);
+    Loader::LinuxNative::RegisterRedZonePatchModule(memory,size,reinterpret_cast<void*>(address+size),32);
+    auto capacity=Loader::LinuxNative::PatchGuestInstructions(address,sizeof(short_code),roots,false,false);
+    Check(capacity.extrq_native_count==0 && capacity.extrq_fallback_count==1,"v2 capacity fallback");
+    Loader::LinuxNative::RegisterRedZonePatchModule(memory,size,reinterpret_cast<void*>(address+(uint64_t{1}<<33)),size);
+    auto far=Loader::LinuxNative::PatchGuestInstructions(address,sizeof(short_code),roots,false,false);
+    Check(far.extrq_native_count==0 && far.extrq_fallback_count==1,"v2 rel32 fallback");
+    Check(std::memcmp(memory,short_code,sizeof(short_code))==0,"v2 capacity/far changed guest");
+    // Execute adjacent sites: first remains trapped rather than copying unsupported EXTRQ;
+    // second is native. No duplicate emission or skipped operation.
+    Loader::LinuxNative::UnregisterRedZonePatchModule(memory);
+    const uint8_t adjacent[]={0xf3,0x0f,0x6f,0x07, 0xf3,0x0f,0x6f,0x4f,0x10,
+        0x66,0x0f,0x79,0xc1, 0x66,0x0f,0x79,0xc1, 0x90,
+        0xf3,0x0f,0x7f,0x06,0xc3};
+    std::memcpy(memory,adjacent,sizeof(adjacent));
+    std::array<uint64_t,4> input{0x123456789abcdef0ull,UINT64_MAX,0x0408,UINT64_MAX};
+    std::array<uint64_t,2> reference{},candidate{};
+    Check(mprotect(memory,size*2,PROT_READ|PROT_EXEC)==0,"adjacent RX reference");
+    using Fn=void(*)(const uint64_t*,uint64_t*);
+    auto fn=reinterpret_cast<Fn>(memory);
+    auto before=LinuxNativeTestTrapCount(); fn(input.data(),reference.data());
+    Check(LinuxNativeTestTrapCount()==before+2,"adjacent reference traps");
+    Check(mprotect(memory,size*2,PROT_READ|PROT_WRITE)==0,"adjacent RW patch");
+    Loader::LinuxNative::RegisterRedZonePatchModule(memory,size,reinterpret_cast<void*>(address+size),size);
+    setenv("KYTY_LINUX_NATIVE_CPU",mode,1);
+    auto a=Loader::LinuxNative::PatchGuestInstructions(address,sizeof(adjacent),roots,false,false);
+    Check(a.extrq_native_count==1 && a.extrq_fallback_count==1,"adjacent native/fallback");
+    Check(mprotect(memory,size*2,PROT_READ|PROT_EXEC)==0,"adjacent RX candidate");
+    before=LinuxNativeTestTrapCount(); fn(input.data(),candidate.data());
+    Check(LinuxNativeTestTrapCount()==before+1 && candidate==reference && candidate[0]==0xe,"adjacent differential execution");
+    Loader::LinuxNative::UnregisterRedZonePatchModule(memory);
+    munmap(memory,size*2);
+    std::printf("PASS: %s planning cases=%zu + v1 short control + adjacent execution; ends, control flow, direct/root targets, earlier overlap, adjacent EXTRQ, invalid decode\n",mode,total);
+}
