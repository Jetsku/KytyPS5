+
+RedZonePatchResult PatchGuestInstructions(u64 address, u64 size,
+                                        std::span<const uintptr_t> function_starts, bool, bool emulate_amd) {
+	RedZonePatchResult result {};
+	if (!LinuxNativeCpuEnabled() || size == 0 || size > UINTPTR_MAX - address) return result;
+	auto* module = GetContainingModule(reinterpret_cast<void*>(address));
+	if (module == nullptr || address + size > reinterpret_cast<u64>(module->end)) return result;
+	std::unique_lock lock {module->mutex};
+	std::vector<uintptr_t> starts;
+	for (auto start : function_starts) if (start >= address && start < address + size) starts.push_back(start);
+	std::ranges::sort(starts);
+	starts.erase(std::ranges::unique(starts).begin(), starts.end());
+	const size_t begin = module->trampoline_gen.getSize();
+	const bool v3 = std::strcmp(std::getenv("KYTY_LINUX_NATIVE_CPU"), "extrq-v3") == 0;
+	const bool v4 = std::strcmp(std::getenv("KYTY_LINUX_NATIVE_CPU"), "extrq-v4") == 0;
+	const bool v2 = v3 || v4 || std::strcmp(std::getenv("KYTY_LINUX_NATIVE_CPU"), "extrq-v2") == 0;
+	u64 constants = 0; // Shared within this patch pass; never an execution entry.
+	std::map<uintptr_t, uintptr_t> intervals;
+	std::set<uintptr_t> all_targets(starts.begin(), starts.end());
+	// Analyze every boundary before changing bytes; direct targets can cross functions.
+	// Keep only targets between passes, not the entire module's large decoded operand file.
+	for (size_t i = 0; i < starts.size(); ++i) {
+		const auto end = i + 1 < starts.size() ? starts[i + 1] : address + size;
+		const auto function = DecodeFunction(starts[i], end, address, address + size);
+		all_targets.insert(function.branch_targets.begin(), function.branch_targets.end());
+		for (const auto& [site, decoded] : function.instructions) {
+			if (v2) intervals[site] = site + decoded.instruction.length;
+			const auto target = GetRelativeTarget(decoded);
+			if (target != 0) all_targets.insert(target);
+		}
+	}
+	for (size_t i = 0; i < starts.size(); ++i) {
+		const auto end = i + 1 < starts.size() ? starts[i + 1] : address + size;
+		const auto function = DecodeFunction(starts[i], end, address, address + size);
+		++result.function_count;
+		result.instruction_count += function.instructions.size();
+		for (const auto& [site, decoded] : function.instructions) {
+			if (decoded.instruction.mnemonic != ZYDIS_MNEMONIC_EXTRQ) continue;
+			++result.extrq_found_count;
+			auto continuation = site + decoded.instruction.length;
+			std::vector<const DecodedCodeInstruction*> neighbors;
+			if (v2 && decoded.instruction.length < NearJumpSize) {
+				// Experimental: roots/direct targets do not prove unknown computed entries.
+				// Only steal decoded, contiguous, non-control-flow ordinary instructions.
+				while (continuation - site < NearJumpSize) {
+					const auto next = function.instructions.find(continuation);
+					if (next == function.instructions.end()) break;
+					const auto& n = next->second;
+					// int15's --amd-cpu pass runs next, on original executable segments.
+					// Do not hide its replacement site inside our separate trampoline.
+					if (emulate_amd &&
+					    (n.instruction.mnemonic == ZYDIS_MNEMONIC_RSQRTPS ||
+					     n.instruction.mnemonic == ZYDIS_MNEMONIC_RSQRTSS ||
+					     n.instruction.mnemonic == ZYDIS_MNEMONIC_VRSQRTPS ||
+					     n.instruction.mnemonic == ZYDIS_MNEMONIC_VRSQRTSS ||
+					     n.instruction.mnemonic == ZYDIS_MNEMONIC_INSERTQ ||
+					     n.instruction.mnemonic == ZYDIS_MNEMONIC_RDPID ||
+					     n.instruction.mnemonic == ZYDIS_MNEMONIC_CLWB)) break;
+					if (n.instruction.mnemonic == ZYDIS_MNEMONIC_EXTRQ ||
+					    IsControlFlowTerminator(n.instruction) ||
+					    n.instruction.meta.category == ZYDIS_CATEGORY_COND_BR ||
+					    n.instruction.meta.category == ZYDIS_CATEGORY_CALL ||
+					    n.instruction.meta.category == ZYDIS_CATEGORY_SYSCALL ||
+					    n.instruction.meta.category == ZYDIS_CATEGORY_X87_ALU ||
+					    std::ranges::any_of(n.operands, [](const auto& op) {
+						    return op.type == ZYDIS_OPERAND_TYPE_IMMEDIATE && op.imm.is_relative;
+					    })) break;
+					neighbors.push_back(&n);
+					continuation += n.instruction.length;
+				}
+			}
+			const auto inner_target = all_targets.upper_bound(site);
+			const auto inner_instruction = function.instructions.upper_bound(site);
+			bool overlap = false;
+			if (v2) {
+				// Includes earlier-starting alternate decode intervals (max x86 length 15).
+				for (auto it = intervals.lower_bound(site > 15 ? site - 15 : 0);
+				     it != intervals.end() && it->first < continuation; ++it) {
+					if (it->second <= site || it->first == site) continue;
+					if (std::ranges::none_of(neighbors, [&](auto* n) { return n->address == it->first; })) {
+						overlap = true; break;
+					}
+				}
+			}
+			if (continuation - site < NearJumpSize || overlap || module->patched.contains(reinterpret_cast<u8*>(site)) ||
+			    (inner_target != all_targets.end() && *inner_target < continuation) ||
+			    (!v2 && inner_instruction != function.instructions.end() && inner_instruction->first < continuation)) continue;
+			auto& c = module->trampoline_gen;
+			const auto offset = c.getSize();
+			const bool new_constants = v4 && decoded.operands[1].type == ZYDIS_OPERAND_TYPE_REGISTER && constants == 0;
+			const auto reserve = new_constants ? 304u : 256u;
+			const auto predicted = reinterpret_cast<u64>(c.getCurr()) + (new_constants ? 47u : 0u);
+			// A generous bounded slot avoids partial emission or exhaustion aborts.
+			if (module->trampoline_capacity - offset < reserve ||
+			    !Xbyak::inner::IsInInt32(static_cast<s64>(predicted) - static_cast<s64>(site + NearJumpSize)) ||
+			    !Xbyak::inner::IsInInt32(static_cast<s64>(continuation) - static_cast<s64>(predicted + 256))) continue;
+			Xbyak::ClearError();
+			if (new_constants) {
+				c.align(16); constants = reinterpret_cast<u64>(c.getCurr());
+				c.dq(63); c.dq(0); c.dq(1); c.dq(0);
+			}
+			const auto trampoline = reinterpret_cast<u64>(c.getCurr());
+			auto rewind = [&] { Xbyak::ClearError(); c.setSize(offset); if (new_constants) constants = 0; };
+			if (!EmitLinuxExtrq(decoded, c, v3, v4, constants)) { rewind(); continue; }
+			bool relocated = true;
+			for (auto* n : neighbors) if (!EncodeRelocatedInstruction(*n, c)) { relocated = false; break; }
+			if (!relocated) { rewind(); continue; }
+			c.jmp(reinterpret_cast<void*>(continuation), Xbyak::CodeGenerator::T_NEAR);
+			if (Xbyak::GetError() != 0 ||
+			    !Xbyak::inner::IsInInt32(static_cast<s64>(trampoline) - static_cast<s64>(site + NearJumpSize))) {
+				rewind(); continue;
+			}
+			const s32 displacement = static_cast<s32>(static_cast<s64>(trampoline) - static_cast<s64>(site + NearJumpSize));
+			auto* bytes = reinterpret_cast<u8*>(site);
+			bytes[0] = 0xe9;
+			std::memcpy(bytes + 1, &displacement, sizeof(displacement));
+			std::memset(bytes + NearJumpSize, 0x90, continuation - site - NearJumpSize);
+			module->patched.insert(bytes);
+			++result.extrq_native_count;
+		}
+	}
+	result.extrq_fallback_count = result.extrq_found_count - result.extrq_native_count;
+	Common::VirtualMemory::FlushInstructionCache(address, size);
+	if (module->trampoline_gen.getSize() != begin)
+		Common::VirtualMemory::FlushInstructionCache(reinterpret_cast<u64>(module->trampoline_gen.getCode()) + begin,
+		                                           module->trampoline_gen.getSize() - begin);
+	return result;
+}
