+// v1 replaces complete >=5-byte EXTRQ only. Explicit extrq-v2 additionally
+// relocates an ordinary contiguous neighbor of a short form.
+bool EmitLinuxExtrq(const DecodedCodeInstruction& decoded, Xbyak::CodeGenerator& c, bool v3, bool v4, u64 constants) {
+	const auto& ops = decoded.operands;
+	if (decoded.instruction.mnemonic != ZYDIS_MNEMONIC_EXTRQ ||
+	    ops[0].type != ZYDIS_OPERAND_TYPE_REGISTER ||
+	    ops[0].reg.value < ZYDIS_REGISTER_XMM0 || ops[0].reg.value > ZYDIS_REGISTER_XMM15) {
+		return false;
+	}
+	const bool immediate = ops[1].type == ZYDIS_OPERAND_TYPE_IMMEDIATE &&
+	                       ops[2].type == ZYDIS_OPERAND_TYPE_IMMEDIATE;
+	const bool registers = ops[1].type == ZYDIS_OPERAND_TYPE_REGISTER &&
+	                       ops[1].reg.value >= ZYDIS_REGISTER_XMM0 &&
+	                       ops[1].reg.value <= ZYDIS_REGISTER_XMM15;
+	if (!immediate && !registers) return false;
+	const Xbyak::Xmm dst(ops[0].reg.value - ZYDIS_REGISTER_XMM0);
+	if (v4 && registers) {
+		const Xbyak::Xmm src(ops[1].reg.value - ZYDIS_REGISTER_XMM0);
+		int a = 0;
+		while (a == dst.getIdx() || a == src.getIdx()) ++a;
+		int b = a + 1;
+		while (b == dst.getIdx() || b == src.getIdx()) ++b;
+		const Xbyak::Xmm index(a), length(b);
+		// The private save area is strictly below the 128-byte guest red zone.
+		// Legacy instructions retain upper YMM; LEA leaves RFLAGS untouched.
+		c.lea(rsp, ptr[rsp - GuestRedZoneSize - 32]);
+		c.movdqu(ptr[rsp], index); c.movdqu(ptr[rsp + 16], length);
+		c.movdqa(index, src); c.movdqa(length, src);
+		c.psllq(index, 50); c.psrlq(index, 58);
+		c.psllq(length, 58); c.psrlq(length, 58);
+		c.pxor(length, ptr[rip + reinterpret_cast<void*>(constants)]);
+		c.paddq(length, ptr[rip + reinterpret_cast<void*>(constants + 16)]);
+		c.pand(length, ptr[rip + reinterpret_cast<void*>(constants)]);
+		c.psrlq(dst, index); c.psllq(dst, length); c.psrlq(dst, length);
+		c.movq(dst, dst);
+		c.movdqu(index, ptr[rsp]); c.movdqu(length, ptr[rsp + 16]);
+		c.lea(rsp, ptr[rsp + GuestRedZoneSize + 32]);
+		return true;
+	}
+	if (v3 && immediate) {
+		u32 length = ops[1].imm.value.u & 63u;
+		const u32 index = ops[2].imm.value.u & 63u;
+		if (length == 0) length = 64;
+		length = std::min(length, 64u - index);
+		// Legacy SSE2 MOVQ xmm,xmm clears bits 127:64, retaining upper YMM.
+		// Shift each 64-bit lane independently; no GPR, flags, stack or MXCSR.
+		c.movq(dst, dst);
+		if (index != 0) c.psrlq(dst, index);
+		if (length < 64u - index) {
+			c.psllq(dst, 64u - length);
+			c.psrlq(dst, 64u - length);
+		}
+		return true;
+	}
+	c.lea(rsp, ptr[rsp - GuestRedZoneSize]);
+	c.pushfq(); c.push(rax); c.push(rcx); c.push(rdx);
+	if (immediate) {
+		u32 length = ops[1].imm.value.u & 63u;
+		const u32 index = ops[2].imm.value.u & 63u;
+		if (length == 0) length = 64;
+		length = std::min(length, 64u - index);
+		const u64 mask = length == 64 ? UINT64_MAX : ((u64{1} << length) - 1);
+		c.movq(rax, dst);
+		if (index != 0) c.shr(rax, index);
+		c.mov(rdx, mask); c.and_(rax, rdx);
+	} else {
+		// Consume the control register before writing dst, including dst==src.
+		const Xbyak::Xmm src(ops[1].reg.value - ZYDIS_REGISTER_XMM0);
+		Xbyak::Label full_length, mask_done;
+		c.movq(rax, src); c.mov(rcx, rax); c.and_(ecx, 63);
+		c.jz(full_length);
+		c.mov(rdx, 1); c.shl(rdx, cl); c.dec(rdx); c.jmp(mask_done);
+		c.L(full_length); c.mov(rdx, UINT64_MAX);
+		c.L(mask_done);
+		c.shr(rax, 8); c.and_(eax, 63); c.mov(ecx, eax);
+		c.movq(rax, dst); c.shr(rax, cl); c.and_(rax, rdx);
+	}
+	// Legacy MOVQ clears high XMM bits while preserving the upper YMM half.
+	c.movq(dst, rax);
+	c.pop(rdx); c.pop(rcx); c.pop(rax); c.popfq();
+	c.lea(rsp, ptr[rsp + GuestRedZoneSize]);
+	return true;
+}
