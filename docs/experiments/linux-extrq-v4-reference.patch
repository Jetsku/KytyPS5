+            Check(_mm_getcsr() == mxcsr, "exhaustive MXCSR sticky/rounding/DAZ/FTZ preservation");
+            Check(std::memcmp(&output, &expected, sizeof(output)) == 0,
+                  "exhaustive SIGILL/v2/v3 XMM/YMM/GPR/RSP/RFLAGS/red-zone equivalence");
+        }
+        ++cases;
+    }
+    _mm_setcsr(saved_mxcsr);
+    std::printf("PASS: exhaustive immediate cases=%llu; 64x64 controls, 4 high-bit wraps, 16 dst, zero/ones/random, SIGILL/v2/v3/v4, architectural state, v3 decoded SSE2-only bodies\n", (unsigned long long)cases);
+}
+std::vector<uint8_t> ImmediateBody(Fixture& f, const char* mode, unsigned length, unsigned index) {
+    setenv("KYTY_LINUX_NATIVE_CPU", mode, 1);
+    const auto p = Generate(f, 0, 0, true, length, index);
+    Loader::LinuxNative::UnregisterRedZonePatchModule(f.memory);
+    Loader::LinuxNative::RegisterRedZonePatchModule(f.memory, Size, reinterpret_cast<void*>(f.address + Size), Size);
+    const std::array<uintptr_t, 1> starts {f.address};
+    Check(Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, starts, false, false).extrq_native_count == 1, "benchmark native emitter");
+    ZydisDecoder decoder;
+    ZydisDecoderInit(&decoder, ZYDIS_MACHINE_MODE_LONG_64, ZYDIS_STACK_WIDTH_64);
+    size_t offset = 0;
+    auto* bytes = reinterpret_cast<uint8_t*>(f.address + Size);
+    for (;;) {
+        ZydisDecodedInstruction instruction;
+        ZydisDecodedOperand ops[ZYDIS_MAX_OPERAND_COUNT];
+        Check(ZYAN_SUCCESS(ZydisDecoderDecodeFull(&decoder, bytes + offset, 256 - offset, &instruction, ops)), "benchmark decode");
+        if (instruction.mnemonic == ZYDIS_MNEMONIC_JMP) break;
+        offset += instruction.length;
+        Check(offset < 256, "benchmark body bounds");
+    }
+    return {bytes, bytes + offset};
+}
+}
+void RunLinuxNativeMicrobenchmark() {
+    Fixture f;
+    constexpr uint64_t iterations = 200000, unroll = 32, operations = iterations * unroll;
+    std::puts("Microbenchmark: actual emitted immediate bodies, identical legacy MOVDQA input reset + 32-way unroll + R8 loop; steady_clock; 7 alternating trials; no FPS inference.");
+    for (const auto controls : {std::array<unsigned, 2>{32, 0}, {16, 16}, {0, 0}, {63, 63}}) {
+        const auto v2 = ImmediateBody(f, "extrq-v2", controls[0], controls[1]);
+        const auto v3 = ImmediateBody(f, "extrq-v3", controls[0], controls[1]);
+        std::array<std::vector<double>, 2> timings;
+        for (unsigned trial = 0; trial < 7; ++trial) for (unsigned order = 0; order < 2; ++order) {
+            const auto mode = (trial + order) & 1u;
+            const auto& body = mode == 0 ? v2 : v3;
+            f.Writable();
+            Xbyak::ClearError();
+            Xbyak::CodeGenerator c(Size, f.memory);
+            c.movdqu(xmm1, c.ptr[rsi]);
+            c.mov(r8, iterations);
+            Xbyak::Label loop;
+            c.align(64); c.L(loop);
+            for (unsigned i = 0; i < unroll; ++i) { c.movdqa(xmm0, xmm1); c.db(body.data(), body.size()); }
+            c.dec(r8); c.jnz(loop, Xbyak::CodeGenerator::T_NEAR);
+            c.movdqu(c.ptr[rdi], xmm0); c.ret();
+            Check(Xbyak::GetError() == 0, "benchmark loop generation");
+            f.Executable();
+            const std::array<uint64_t, 2> input {0x123456789abcdef0ull, UINT64_MAX};
+            std::array<uint64_t, 2> output {};
+            const auto run = reinterpret_cast<void (*)(void*, const void*)>(f.memory);
+            run(output.data(), input.data()); // identical warmup, excluded
+            const auto begin = std::chrono::steady_clock::now();
+            run(output.data(), input.data());
+            const double ns = std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - begin).count();
+            unsigned length = controls[0] & 63, index = controls[1] & 63;
+            if (length == 0) length = 64;
+            length = std::min(length, 64 - index);
+            const auto mask = length == 64 ? UINT64_MAX : ((uint64_t{1} << length) - 1);
+            Check(output[0] == ((input[0] >> index) & mask) && output[1] == 0, "benchmark architectural output");
+            timings[mode].push_back(ns);
+            std::printf("BENCH trial=%u mode=v%u length=%u index=%u operations=%llu elapsed_ns=%.0f ns/op=%.6f body_bytes=%zu\n", trial, mode + 2, controls[0], controls[1], (unsigned long long)operations, ns, ns / operations, body.size());
+        }
+        for (auto& times : timings) std::sort(times.begin(), times.end());
+        std::printf("BENCH SUMMARY length=%u index=%u operations/trial=%llu v2_median_ns/op=%.6f v3_median_ns/op=%.6f\n", controls[0], controls[1], (unsigned long long)operations, timings[0][3] / operations, timings[1][3] / operations);
+    }
+}
+struct RegisterBody {
+    uintptr_t address;
+    std::vector<uint8_t> bytes;
+};
+RegisterBody GetRegisterBody(Fixture& f, const char* mode, int dst, int src) {
+    setenv("KYTY_LINUX_NATIVE_CPU", mode, 1);
+    const auto p = Generate(f, dst, src, false, 0, 0, 1);
+    Loader::LinuxNative::UnregisterRedZonePatchModule(f.memory);
+    Loader::LinuxNative::RegisterRedZonePatchModule(f.memory, Size, reinterpret_cast<void*>(f.address + Size), Size);
+    const std::array<uintptr_t, 1> starts {f.address};
+    Check(Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, starts, false, false).extrq_native_count == 1, "register benchmark actual emitter");
+    const auto entry = Entry(f, p);
+    ZydisDecoder decoder;
+    ZydisDecoderInit(&decoder, ZYDIS_MACHINE_MODE_LONG_64, ZYDIS_STACK_WIDTH_64);
+    size_t offset = 0;
+    for (;;) {
+        ZydisDecodedInstruction ins;
+        ZydisDecodedOperand ops[ZYDIS_MAX_OPERAND_COUNT];
+        Check(ZYAN_SUCCESS(ZydisDecoderDecodeFull(&decoder, reinterpret_cast<void*>(entry + offset), 256 - offset, &ins, ops)), "register benchmark body decode");
+        offset += ins.length;
+        if (ins.mnemonic == ZYDIS_MNEMONIC_LEA && ops[1].mem.base == ZYDIS_REGISTER_RSP && ops[1].mem.disp.value > 0) break;
+        Check(offset < 256, "register benchmark body bound");
+    }
+    auto* bytes = reinterpret_cast<uint8_t*>(entry);
+    return {entry, {bytes, bytes + offset}};
+}
+void AppendRegisterBody(Xbyak::CodeGenerator& c, const RegisterBody& body) {
+    ZydisDecoder decoder;
+    ZydisDecoderInit(&decoder, ZYDIS_MACHINE_MODE_LONG_64, ZYDIS_STACK_WIDTH_64);
+    for (size_t offset = 0; offset < body.bytes.size();) {
+        ZydisDecodedInstruction ins;
+        ZydisDecodedOperand ops[ZYDIS_MAX_OPERAND_COUNT];
+        Check(ZYAN_SUCCESS(ZydisDecoderDecodeFull(&decoder, body.bytes.data() + offset, body.bytes.size() - offset, &ins, ops)), "benchmark relocate decode");
+        std::array<uint8_t, 15> bytes {};
+        std::memcpy(bytes.data(), body.bytes.data() + offset, ins.length);
+        for (unsigned i = 0; i < ins.operand_count; ++i) if (ops[i].type == ZYDIS_OPERAND_TYPE_MEMORY && ops[i].mem.base == ZYDIS_REGISTER_RIP) {
+            const auto target = body.address + offset + ins.length + ops[i].mem.disp.value;
+            const auto delta = static_cast<int64_t>(target) - static_cast<int64_t>(reinterpret_cast<uintptr_t>(c.getCurr()) + ins.length);
+            Check(ins.raw.disp.size == 32 && Xbyak::inner::IsInInt32(delta), "benchmark constant rel32");
+            const int32_t displacement = delta;
+            std::memcpy(bytes.data() + ins.raw.disp.offset, &displacement, 4);
+        }
+        c.db(bytes.data(), ins.length); offset += ins.length;
+    }
+}
+void RunRegisterMicrobenchmark() {
+    Fixture old_body, new_body, loop;
+    constexpr uint64_t iterations = 200000, unroll = 32, operations = iterations * unroll;
+    std::puts("V4 microbenchmark: actual emitted register bodies; only RIP constants relocated; identical memory input resets, 32-way unroll/R8 loop, warmup excluded, 7 alternating trials. Game not touched; no FPS inference.");
+    for (const auto pair : {std::array<int, 2>{0, 1}, {1, 0}, {9, 10}, {0, 0}, {15, 15}}) {
+        const auto v2 = GetRegisterBody(old_body, "extrq-v2", pair[0], pair[1]);
+        const auto v4 = GetRegisterBody(new_body, "extrq-v4", pair[0], pair[1]);
+        for (const auto controls : {std::array<unsigned, 2>{0, 0}, {32, 0}, {16, 16}, {1, 63}, {63, 63}, {255, 255}, {256, 256}}) {
+            // 256 denotes the mixed per-operation sequence, not a guest control byte.
+            std::array<std::array<uint64_t, 4>, unroll> inputs {};
+            for (unsigned i = 0; i < unroll; ++i) {
+                const auto len = controls[0] == 256 ? (i * 17u) & 255u : controls[0];
+                const auto idx = controls[1] == 256 ? (i * 31u) & 255u : controls[1];
+                inputs[i] = {0x123456789abcdef0ull, UINT64_MAX, 0xfedcba9876540000ull | len | (idx << 8), UINT64_MAX};
+                if (pair[0] == pair[1]) inputs[i][0] = inputs[i][2];
+            }
+            std::array<std::vector<double>, 2> times;
+            for (unsigned trial = 0; trial < 7; ++trial) for (unsigned order = 0; order < 2; ++order) {
+                const auto mode = (trial + order) & 1u;
+                const auto& body = mode == 0 ? v2 : v4;
+                loop.Writable(); Xbyak::ClearError();
+                Xbyak::CodeGenerator c(Size, loop.memory);
+                c.mov(r8, iterations);
+                Xbyak::Label label; c.align(64); c.L(label);
+                for (unsigned i = 0; i < unroll; ++i) {
+                    c.movdqu(Xbyak::Xmm(pair[0]), c.ptr[rsi + i * 32]);
+                    if (pair[0] != pair[1]) c.movdqu(Xbyak::Xmm(pair[1]), c.ptr[rsi + i * 32 + 16]);
+                    AppendRegisterBody(c, body);
+                }
+                c.dec(r8); c.jnz(label, Xbyak::CodeGenerator::T_NEAR);
+                c.movdqu(c.ptr[rdi], Xbyak::Xmm(pair[0])); c.ret();
+                Check(Xbyak::GetError() == 0, "register benchmark loop generation");
+                loop.Executable();
+                std::array<uint64_t, 2> output {};
+                const auto run = reinterpret_cast<void (*)(void*, const void*)>(loop.memory);
+                run(output.data(), inputs.data());
+                const auto begin = std::chrono::steady_clock::now();
+                run(output.data(), inputs.data());
+                const double ns = std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - begin).count();
+                unsigned len = inputs.back()[2] & 63u, idx = (inputs.back()[2] >> 8) & 63u;
+                if (len == 0) len = 64;
+                const uint64_t mask = len == 64 ? UINT64_MAX : ((uint64_t{1} << len) - 1);
+                Check(output[0] == ((inputs.back()[0] >> idx) & mask) && output[1] == 0, "register benchmark output");
+                times[mode].push_back(ns / operations);
+                std::printf("V4BENCH trial=%u mode=v%u dst=%d src=%d length=%u index=%u operations=%llu ns/op=%.6f body_bytes=%zu\n", trial, mode == 0 ? 2 : 4, pair[0], pair[1], controls[0], controls[1], (unsigned long long)operations, ns / operations, body.bytes.size());
+            }
+            for (auto& t : times) std::sort(t.begin(), t.end());
+            std::printf("V4BENCH SUMMARY dst=%d src=%d length=%u index=%u v2_median=%.6f v4_median=%.6f ratio=%.6f\n", pair[0], pair[1], controls[0], controls[1], times[0][3], times[1][3], times[0][3] / times[1][3]);
+        }
+    }
+}
+void RunLinuxNativeEquivalenceTests() {
+    Fixture identity;
+    for (auto length : {0u, 1u, 31u, 63u, 64u, 255u}) for (auto index : {0u, 1u, 31u, 63u, 64u, 255u}) {
+        const auto old_body = ImmediateBody(identity, "extrq-v2", length, index);
+        const auto new_body = ImmediateBody(identity, "extrq-v4", length, index);
+        Check(old_body == new_body, "v4 immediate emitter must remain byte-identical to v2");
+    }
+    std::puts("PASS: v4 immediate/v2 emitted body identity (36 control pairs); default immediate not v3");
+    V4Smoke(); ExhaustiveV4Register(); V3Smoke(); ExhaustiveV3Immediate(); Fallbacks(); Matrix(false, 0);
+    for (int n = 0; n <= 4; ++n) Matrix(true, n);
+    for (int n = 0; n <= 4; ++n) Matrix(true, n, true);
+    for (int n = 0; n <= 4; ++n) Matrix(true, n, false, true);
+}
