new file mode 100644
index 0000000..580bff3
--- /dev/null
+++ b/tests/linuxNativeEquivalenceTests.cpp
@@ -0,0 +1,582 @@
+// Differential execution against the existing Linux SIGILL emulator.
+#include "loader/redZonePatcher.h"
+#include "loader/x64InstructionEmulator.h"
+#define XBYAK_NO_EXCEPTION
+#include <xbyak/xbyak.h>
+#include <xbyak/xbyak_util.h>
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+#include <sys/mman.h>
+#include <xmmintrin.h>
+#include <Zydis/Zydis.h>
+#include <chrono>
+#include <algorithm>
+
+int LinuxNativeTestTrapCount();
+namespace {
+using namespace Xbyak::util;
+void Check(bool ok, const char* message) {
+    if (!ok) { std::fprintf(stderr, "FAIL: %s\n", message); std::exit(4); }
+}
+struct State {
+    uint64_t ymm[16][4];
+    uint64_t gpr[16];
+    uint64_t red_zone[16];
+    uint64_t flags;
+};
+constexpr size_t Size = 0x4000;
+struct Fixture {
+    void* memory = mmap(nullptr, Size * 3, PROT_READ | PROT_WRITE,
+                        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    uintptr_t address = reinterpret_cast<uintptr_t>(memory);
+    Fixture() { Check(memory != MAP_FAILED, "mmap"); }
+    ~Fixture() { Loader::LinuxNative::UnregisterRedZonePatchModule(memory); munmap(memory, Size * 3); }
+    void Writable() { Check(mprotect(memory, Size * 2, PROT_READ | PROT_WRITE) == 0, "RW transition"); }
+    void Executable() { Check(mprotect(memory, Size * 2, PROT_READ | PROT_EXEC) == 0, "RX transition"); }
+};
+struct Program { size_t size, site, length, span; };
+Program Generate(Fixture& f, int dst, int src, bool immediate, unsigned length, unsigned index, int neighbor = 0) {
+    f.Writable();
+    Xbyak::ClearError();
+    Xbyak::CodeGenerator c(Size, f.memory);
+    for (auto r : {rbx, rbp, r12, r13, r14, r15}) c.push(r);
+    for (int i = 0; i < 16; ++i) c.vmovdqu(Xbyak::Ymm(i), c.ptr[rdi + i * 32]);
+    for (int i = 1; i <= 16; ++i) {
+        c.mov(rax, 0x1122334455667788ull ^ i);
+        c.mov(c.qword[rsp - i * 8], rax);
+    }
+    const std::array<Xbyak::Reg64, 16> regs {rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi,
+                                           r8, r9, r10, r11, r12, r13, r14, r15};
+    for (int i = 0; i < 16; ++i)
+        if (i != 4 && i != 6 && i != 7) c.mov(regs[i], 0x8877665544332200ull + i);
+    // Deterministic flags, including CF/PF/AF/ZF/SF/OF; no stack write in the red zone.
+    c.lea(rsp, c.ptr[rsp - 128]); c.push(0xad7); c.popfq(); c.lea(rsp, c.ptr[rsp + 128]);
+    const auto site = c.getSize();
+    c.db(0x66);
+    const unsigned rex = immediate ? (dst >= 8 ? 0x41 : 0) :
+                         ((dst >= 8 ? 0x44 : 0) | (src >= 8 ? 0x41 : 0));
+    if (rex) c.db(rex);
+    c.db(0x0f); c.db(immediate ? 0x78 : 0x79);
+    c.db(immediate ? 0xc0 | (dst & 7) : 0xc0 | ((dst & 7) << 3) | (src & 7));
+    if (immediate) { c.db(length); c.db(index); }
+    const auto instruction_length = c.getSize() - site;
+    Xbyak::Label neighbors, constant;
+    if (neighbor == 1) c.nop();
+    if (neighbor == 2) c.mov(r11, c.qword[c.rip + constant]);
+    if (neighbor == 3) c.mov(c.qword[c.rip + reinterpret_cast<void*>(f.address + Size * 2)], r11);
+    if (neighbor == 4) c.add(r10, 13);
+    const auto span = c.getSize() - site;
+    c.jmp(neighbors, Xbyak::CodeGenerator::T_SHORT);
+    c.nop(); c.nop();
+    c.L(neighbors);
+    if (neighbor == 3) c.mov(r11, c.qword[c.rip + reinterpret_cast<void*>(f.address + Size * 2)]);
+    else if (neighbor != 2) c.mov(r11, c.qword[c.rip + constant]);
+    for (int i = 0; i < 16; ++i) c.vmovdqu(c.ptr[rsi + i * 32], Xbyak::Ymm(i));
+    for (int i = 0; i < 16; ++i) c.mov(c.qword[rsi + offsetof(State, gpr) + i * 8], regs[i]);
+    c.lea(rsp, c.ptr[rsp - 128]); c.pushfq(); c.pop(rax); c.lea(rsp, c.ptr[rsp + 128]);
+    c.mov(c.qword[rsi + offsetof(State, flags)], rax);
+    for (int i = 1; i <= 16; ++i) {
+        c.mov(rax, c.qword[rsp - i * 8]);
+        c.mov(c.qword[rsi + offsetof(State, red_zone) + (i - 1) * 8], rax);
+    }
+    for (auto r : {r15, r14, r13, r12, rbp, rbx}) c.pop(r);
+    c.vzeroupper(); c.ret();
+    c.L(constant); c.dq(0x123456780000ffffull);
+    Check(Xbyak::GetError() == 0, "test code generation");
+    return {c.getSize(), site, instruction_length, span};
+}
+void Execute(Fixture& f, const State& input, State& output) {
+    reinterpret_cast<void (*)(const State*, State*)>(f.memory)(&input, &output);
+}
+void Matrix(bool v2, int neighbor, bool v3 = false, bool v4 = false) {
+    setenv("KYTY_LINUX_NATIVE_CPU", v4 ? "extrq-v4" : v3 ? "extrq-v3" : (v2 ? "extrq-v2" : "extrq"), 1);
+    if (!Xbyak::util::Cpu().has(Xbyak::util::Cpu::tAVX)) {
+        std::puts("SKIP: YMM preservation matrix requires AVX host"); return;
+    }
+    Fixture f;
+    std::mt19937_64 random(0x459ce15);
+    std::array<unsigned, 16> controls {0, 1, 7, 8, 31, 32, 63, 64, 65, 127, 128, 255};
+    for (int i = 12; i < 16; ++i) controls[i] = random() & 255;
+    uint64_t cases = 0, native = 0, fallback = 0;
+    const uint32_t saved_mxcsr = _mm_getcsr();
+    for (bool immediate : {true, false}) for (int dst = 0; dst < 16; ++dst)
+    for (int src = 0; src < (immediate ? 1 : 16); ++src)
+    for (auto length : controls) for (auto index : controls) {
+        State input {}, output {};
+        for (auto& reg : input.ymm) for (auto& qword : reg) qword = random();
+        if (!immediate) input.ymm[src][0] = (input.ymm[src][0] & ~uint64_t{0xffff}) | length | (index << 8);
+        const auto p = Generate(f, dst, src, immediate, length, index, neighbor);
+        const std::vector<uint8_t> original(static_cast<uint8_t*>(f.memory), static_cast<uint8_t*>(f.memory) + p.size);
+        f.Executable();
+        const uint32_t mxcsr = 0x1fa1u | ((cases & 3u) << 13u) | ((cases & 4u) << 4u);
+        _mm_setcsr(mxcsr);
+        Execute(f, input, output);
+        Check(_mm_getcsr() == mxcsr, "reference MXCSR preservation");
+        const State expected = output;
+        f.Writable();
+        Loader::LinuxNative::UnregisterRedZonePatchModule(f.memory);
+        Loader::LinuxNative::RegisterRedZonePatchModule(f.memory, Size, reinterpret_cast<void*>(f.address + Size), Size);
+        const std::array<uintptr_t, 1> starts {f.address};
+        const auto result = Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, starts, false, false);
+        Check(result.extrq_found_count == 1, "CFG lost EXTRQ");
+        const bool is_native = p.length >= 5 || (v2 && neighbor != 0);
+        Check(result.extrq_native_count == (is_native ? 1u : 0u), "native/fallback coverage");
+        native += result.extrq_native_count; fallback += result.extrq_fallback_count;
+        // v1 modifies only EXTRQ; v2 may modify its complete stolen neighbor too.
+        const auto* patched = static_cast<const uint8_t*>(f.memory);
+        for (size_t j = 0; j < p.size; ++j)
+            if (j < p.site || j >= p.site + (v2 && p.length < 5 && is_native ? p.span : p.length)) Check(patched[j] == original[j], "patch modified neighbors/data");
+        f.Executable();
+        std::memset(&output, 0, sizeof(output));
+        const auto traps_before = LinuxNativeTestTrapCount();
+        Execute(f, input, output);
+        Check(LinuxNativeTestTrapCount() == traps_before + (is_native ? 0 : 1), "native still SIGILL / fallback lost trap");
+        Check(_mm_getcsr() == mxcsr, "candidate MXCSR preservation");
+        Check(std::memcmp(&output, &expected, sizeof(output)) == 0,
+              "bit-exact XMM/YMM/GPR/RFLAGS/red-zone differential");
+        ++cases;
+    }
+    _mm_setcsr(saved_mxcsr);
+    std::printf("PASS: EXTRQ matrix v2=%d v3=%d v4=%d neighbor=%d cases=%llu native=%llu fallback=%llu; all 16 registers, dst==src, controls, seeded random, GPR/RFLAGS/red-zone/YMM/MXCSR\n",
+                v2, v3, v4, neighbor, (unsigned long long)cases, (unsigned long long)native, (unsigned long long)fallback);
+}
+void Fallbacks() {
+    Fixture f;
+    State input {};
+    for (auto& reg : input.ymm) for (auto& qword : reg) qword = 0x123456789abcdef0ull;
+    for (const char* option : {"", "0", "trap", "rsqrt", "all", "1"}) {
+        setenv("KYTY_LINUX_NATIVE_CPU", option, 1);
+        Check(!Loader::LinuxNative::LinuxNativeCpuEnabled(), "unknown option enabled native path");
+        auto p = Generate(f, 0, 0, true, 8, 4);
+        Loader::LinuxNative::RegisterRedZonePatchModule(f.memory, Size, reinterpret_cast<void*>(f.address + Size), Size);
+        const std::array<uintptr_t, 1> starts {f.address};
+        auto result = Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, starts, false, false);
+        Check(result.extrq_native_count == 0, "disabled path changed code");
+    }
+    unsetenv("KYTY_LINUX_NATIVE_CPU"); Check(!Loader::LinuxNative::LinuxNativeCpuEnabled(), "default not OFF");
+    setenv("KYTY_LINUX_NATIVE_CPU", "extrq", 1);
+    const auto p = Generate(f, 0, 0, true, 8, 4);
+    const std::array<uintptr_t, 1> starts {f.address};
+    Loader::LinuxNative::UnregisterRedZonePatchModule(f.memory);
+    Check(Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, starts, false, false).extrq_native_count == 0,
+          "unregistered module must fail safe");
+    Loader::LinuxNative::RegisterRedZonePatchModule(f.memory, Size, reinterpret_cast<void*>(f.address + Size), 32);
+    auto result = Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, starts, false, false);
+    Check(result.extrq_native_count == 0 && result.extrq_fallback_count == 1, "capacity fallback");
+    Loader::LinuxNative::RegisterRedZonePatchModule(f.memory, Size, reinterpret_cast<void*>(f.address + (uint64_t{1} << 33)), Size);
+    const auto far = Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, starts, false, false);
+    Check(far.extrq_found_count == 1 && far.extrq_native_count == 0 && far.extrq_fallback_count == 1,
+          "out-of-rel32 trampoline must retain fallback without writing unmapped memory");
+    Check(Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, {}, false, false).extrq_native_count == 0,
+          "missing function boundaries fallback");
+    Check(Loader::LinuxNative::PatchGuestInstructions(f.address, UINT64_MAX, starts, false, false).extrq_native_count == 0,
+          "overflow fallback");
+    // Decode failure must stop this block rather than scan one byte and mistake data for code.
+    f.Writable();
+    const uint8_t data[] = {0x0f, 0x04, 0x66, 0x0f, 0x78, 0xc0, 8, 4};
+    std::memcpy(f.memory, data, sizeof(data));
+    Loader::LinuxNative::RegisterRedZonePatchModule(f.memory, Size, reinterpret_cast<void*>(f.address + Size), Size);
+    Check(Loader::LinuxNative::PatchGuestInstructions(f.address, sizeof(data), starts, false, false).extrq_found_count == 0,
+          "decoder must not scan data after failure");
+    // A direct jump over embedded data only visits the real target.
+    const uint8_t jumped[] = {0xeb, 6, 0x66, 0x0f, 0x78, 0xc0, 8, 4, 0xc3};
+    std::memcpy(f.memory, jumped, sizeof(jumped));
+    Check(Loader::LinuxNative::PatchGuestInstructions(f.address, sizeof(jumped), starts, false, false).extrq_found_count == 0,
+          "CFG must not patch skipped data");
+    // A branch in another EH-frame function into the middle of EXTRQ forbids rewriting it.
+    f.Writable();
+    std::array<uint8_t, 23> overlapping {};
+    overlapping.fill(0x90);
+    overlapping[0] = 0xe9;
+    const int32_t displacement = 17 - 5;
+    std::memcpy(overlapping.data() + 1, &displacement, sizeof(displacement));
+    const uint8_t target[] = {0x66, 0x0f, 0x78, 0xc0, 8, 4, 0xc3};
+    std::memcpy(overlapping.data() + 16, target, sizeof(target));
+    std::memcpy(f.memory, overlapping.data(), overlapping.size());
+    Loader::LinuxNative::RegisterRedZonePatchModule(f.memory, Size, reinterpret_cast<void*>(f.address + Size), Size);
+    const std::array<uintptr_t, 2> cross_starts {f.address, f.address + 16};
+    const auto cross = Loader::LinuxNative::PatchGuestInstructions(f.address, overlapping.size(), cross_starts, false, false);
+    Check(cross.extrq_found_count == 1 && cross.extrq_native_count == 0,
+          "cross-function branch into an instruction must retain fallback");
+    std::puts("PASS: default/OFF/unknown options, capacity, missing boundaries/module, overflow, invalid decode, jumped data, cross-function target fallback");
+}
+}
+namespace {
+size_t CheckV3Body(Fixture& f, int dst) {
+    ZydisDecoder decoder;
+    ZydisDecoderInit(&decoder, ZYDIS_MACHINE_MODE_LONG_64, ZYDIS_STACK_WIDTH_64);
+    size_t offset = 0;
+    for (;;) {
+        ZydisDecodedInstruction instruction;
+        ZydisDecodedOperand ops[ZYDIS_MAX_OPERAND_COUNT];
+        Check(ZYAN_SUCCESS(ZydisDecoderDecodeFull(&decoder,
+              reinterpret_cast<void*>(f.address + Size + offset), 256 - offset,
+              &instruction, ops)), "v3 trampoline decode");
+        if (instruction.mnemonic == ZYDIS_MNEMONIC_JMP) return offset;
+        Check(instruction.encoding == ZYDIS_INSTRUCTION_ENCODING_LEGACY,
+              "v3 immediate must use legacy SSE, not VEX");
+        Check(instruction.mnemonic == ZYDIS_MNEMONIC_MOVQ ||
+              instruction.mnemonic == ZYDIS_MNEMONIC_PSRLQ ||
+              instruction.mnemonic == ZYDIS_MNEMONIC_PSLLQ,
+              "v3 immediate body must contain only register-only SSE2");
+        for (unsigned i = 0; i < instruction.operand_count; ++i) {
+            Check(ops[i].type == ZYDIS_OPERAND_TYPE_IMMEDIATE ||
+                  (ops[i].type == ZYDIS_OPERAND_TYPE_REGISTER &&
+                   ops[i].reg.value == ZYDIS_REGISTER_XMM0 + dst),
+                  "v3 immediate touches memory, GPR, flags or another XMM");
+        }
+        offset += instruction.length;
+        Check(offset < 256, "v3 trampoline bounds");
+    }
+}
+uintptr_t Entry(Fixture& f, const Program& p) {
+    int32_t displacement;
+    std::memcpy(&displacement, reinterpret_cast<void*>(f.address + p.site + 1), 4);
+    return f.address + p.site + 5 + displacement;
+}
+size_t CheckV4Body(Fixture& f, const Program& p, int dst, int src) {
+    const auto entry = Entry(f, p);
+    ZydisDecoder decoder;
+    ZydisDecoderInit(&decoder, ZYDIS_MACHINE_MODE_LONG_64, ZYDIS_STACK_WIDTH_64);
+    size_t offset = 0;
+    int scratch[2] {-1, -1}; unsigned saves = 0, restores = 0, constants = 0, leas = 0;
+    for (unsigned n = 0; n < 19; ++n) {
+        ZydisDecodedInstruction ins;
+        ZydisDecodedOperand ops[ZYDIS_MAX_OPERAND_COUNT];
+        Check(ZYAN_SUCCESS(ZydisDecoderDecodeFull(&decoder, reinterpret_cast<void*>(entry + offset),
+              256 - offset, &ins, ops)), "v4 body decode");
+        Check(ins.encoding == ZYDIS_INSTRUCTION_ENCODING_LEGACY, "v4 must not use VEX");
+        Check(ins.mnemonic == ZYDIS_MNEMONIC_LEA || ins.mnemonic == ZYDIS_MNEMONIC_MOVDQU ||
+              ins.mnemonic == ZYDIS_MNEMONIC_MOVDQA || ins.mnemonic == ZYDIS_MNEMONIC_MOVQ ||
+              ins.mnemonic == ZYDIS_MNEMONIC_PSLLQ || ins.mnemonic == ZYDIS_MNEMONIC_PSRLQ ||
+              ins.mnemonic == ZYDIS_MNEMONIC_PXOR || ins.mnemonic == ZYDIS_MNEMONIC_PADDQ ||
+              ins.mnemonic == ZYDIS_MNEMONIC_PAND, "v4 opcode modifies flags/GPR or unsupported body");
+        for (unsigned i = 0; i < ins.operand_count; ++i) {
+            const auto& op = ops[i];
+            if (op.type == ZYDIS_OPERAND_TYPE_REGISTER) {
+                Check((op.reg.value >= ZYDIS_REGISTER_XMM0 && op.reg.value <= ZYDIS_REGISTER_XMM15) ||
+                      (ins.mnemonic == ZYDIS_MNEMONIC_LEA && op.reg.value == ZYDIS_REGISTER_RSP),
+                      "v4 touches GPR/RFLAGS/MXCSR");
+            }
+            if (op.type != ZYDIS_OPERAND_TYPE_MEMORY) continue;
+            Check(op.mem.index == ZYDIS_REGISTER_NONE, "v4 indexed memory");
+            if (ins.mnemonic == ZYDIS_MNEMONIC_LEA) {
+                Check(op.mem.base == ZYDIS_REGISTER_RSP && op.mem.disp.value == (leas++ == 0 ? -160 : 160), "v4 RSP adjustment");
+            } else if (op.mem.base == ZYDIS_REGISTER_RSP) {
+                Check(ins.mnemonic == ZYDIS_MNEMONIC_MOVDQU && (op.mem.disp.value == 0 || op.mem.disp.value == 16), "v4 private scratch bounds");
+                if (i == 0) {
+                    Check(saves < 2, "v4 extra scratch save");
+                    scratch[saves++] = ops[1].reg.value - ZYDIS_REGISTER_XMM0;
+                } else {
+                    Check(restores < 2 && ops[0].reg.value == ZYDIS_REGISTER_XMM0 + scratch[restores++], "v4 scratch restoration");
+                }
+            } else {
+                Check(op.mem.base == ZYDIS_REGISTER_RIP && i == 1 &&
+                      (ins.mnemonic == ZYDIS_MNEMONIC_PXOR || ins.mnemonic == ZYDIS_MNEMONIC_PADDQ || ins.mnemonic == ZYDIS_MNEMONIC_PAND), "v4 non-private memory");
+                const auto target = entry + offset + ins.length + op.mem.disp.value;
+                Check(target >= f.address + Size && target + 16 <= entry && target % 16 == 0, "v4 constants not aligned/bounded/outside execution");
+                const auto* values = reinterpret_cast<const uint64_t*>(target);
+                Check(values[0] == (ins.mnemonic == ZYDIS_MNEMONIC_PADDQ ? 1u : 63u) && values[1] == 0, "v4 constant contents");
+                ++constants;
+            }
+        }
+        offset += ins.length;
+    }
+    Check(saves == 2 && restores == 2 && constants == 3 && leas == 2 &&
+          scratch[0] != scratch[1] && scratch[0] != dst && scratch[0] != src &&
+          scratch[1] != dst && scratch[1] != src, "v4 scratch collision or incomplete body");
+    return offset;
+}
+void ExhaustiveV4Register() {
+    Check(Xbyak::util::Cpu().has(Xbyak::util::Cpu::tAVX), "v4 upper-YMM matrix needs AVX");
+    Fixture f, reference;
+    std::mt19937_64 random(0x444459ce15);
+    const auto saved_mxcsr = _mm_getcsr();
+    uint64_t cases = 0;
+    for (int dst = 0; dst < 16; ++dst) for (int src = 0; src < 16; ++src) {
+        Generate(reference, dst, src, false, 0, 0, 1); reference.Executable();
+        const auto p = Generate(f, dst, src, false, 0, 0, 1);
+        Loader::LinuxNative::UnregisterRedZonePatchModule(f.memory);
+        Loader::LinuxNative::RegisterRedZonePatchModule(f.memory, Size, reinterpret_cast<void*>(f.address + Size), Size);
+        setenv("KYTY_LINUX_NATIVE_CPU", "extrq-v4", 1);
+        const std::array<uintptr_t, 1> starts {f.address};
+        Check(Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, starts, false, false).extrq_native_count == 1, "v4 register native matrix");
+        CheckV4Body(f, p, dst, src); f.Executable();
+        for (unsigned length = 0; length < 64; ++length) for (unsigned index = 0; index < 64; ++index)
+        for (unsigned wrap = 0; wrap < 4; ++wrap) {
+            State input {}, output {};
+            for (auto& reg : input.ymm) for (auto& q : reg) q = wrap == 0 ? 0 : wrap == 1 ? UINT64_MAX : random();
+            input.ymm[src][0] = (random() & ~uint64_t{0xffff}) | length | (wrap << 6) | (index << 8) | (((wrap + dst) & 3) << 14);
+            const uint32_t mxcsr = 0x1fbfu | ((cases & 3u) << 13u) | ((cases & 4u) << 4u) | ((cases & 8u) << 12u);
+            _mm_setcsr(mxcsr);
+            const auto before = LinuxNativeTestTrapCount();
+            Execute(reference, input, output);
+            Check(LinuxNativeTestTrapCount() == before + 1 && _mm_getcsr() == mxcsr, "v4 actual SIGILL reference/MXCSR");
+            const State expected = output;
+            std::memset(&output, 0, sizeof(output));
+            Execute(f, input, output);
+            Check(LinuxNativeTestTrapCount() == before + 1 && _mm_getcsr() == mxcsr, "v4 native trap/MXCSR");
+            Check(std::memcmp(&output, &expected, sizeof(output)) == 0, "v4 full state differential");
+            ++cases;
+        }
+    }
+    _mm_setcsr(saved_mxcsr);
+    std::printf("PASS: v4 register exhaustive cases=%llu; 256 dst/src combinations, 64x64 controls, 4 wraps, random high control bits, full XMM/YMM/GPR/RSP/RFLAGS/MXCSR/red-zone; decoded scratch/no-GPR/legacy body\n", (unsigned long long)cases);
+}
