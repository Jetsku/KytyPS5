+            const auto result = Loader::LinuxNative::PatchGuestInstructions(f.address, p.size, starts, false, false);
+            Check(result.extrq_native_count == 1, "exhaustive immediate must be native");
+            if (mode[7] == '3') Check(CheckV3Body(f, dst) > 0, "exhaustive body missing");
+            f.Executable();
+            std::memset(&output, 0, sizeof(output));
+            const auto traps = LinuxNativeTestTrapCount();
+            Execute(f, input, output);
