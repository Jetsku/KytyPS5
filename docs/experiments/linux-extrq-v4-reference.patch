+        expected = output;
+        Check(LinuxNativeTestTrapCount() == before + 1, "reference must execute actual SIGILL emulator");
+        Check(_mm_getcsr() == mxcsr, "exhaustive reference MXCSR");
+        for (const char* mode : {"extrq-v2", "extrq-v3", "extrq-v4"}) {
+            setenv("KYTY_LINUX_NATIVE_CPU", mode, 1);
