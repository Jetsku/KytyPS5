+bool LinuxNativeCpuEnabled() {
+#if defined(__linux__)
+	const auto* value = std::getenv("KYTY_LINUX_NATIVE_CPU");
+	return value != nullptr && (std::strcmp(value, "extrq") == 0 || std::strcmp(value, "extrq-v2") == 0 ||
+	                            std::strcmp(value, "extrq-v3") == 0 || std::strcmp(value, "extrq-v4") == 0);
+#else
+	return false;
+#endif
+}
